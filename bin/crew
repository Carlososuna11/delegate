#!/usr/bin/python3 -I
"""crew: launch remote coding agents and build their briefs.

This is the only entry point of crew. It runs with `-I`, so sys.path carries
neither the script's directory nor the user site; ../lib is added here,
resolving symlinks, so an installed link still loads the real package.
"""
import os
import sys

_SELF = os.path.realpath(__file__)
_LIB = os.path.join(os.path.dirname(os.path.dirname(_SELF)), "lib")
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)

from crew.cli import main  # noqa: E402


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
