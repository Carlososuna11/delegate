#!/usr/bin/env bash
# delegate — manda trabajo de código acotado a un modelo más barato.
#
# Corre el harness de Claude Code en headless contra el endpoint
# Anthropic-compatible del proveedor, fijándolo SOLO en este proceso: la sesión
# principal no se toca. Los invariantes que esto sostiene están en CLAUDE.md.
#
#   delegate deepseek "revisa src/auth.ts y lista los error paths"
#   delegate deepseek --edit --bash "arregla y corre los tests"
#   delegate qwen --timeout 2400 "segunda opinión de este PR"
#   delegate deepseek chat "explica este regex"
#
#   delegate account deepseek list|add|use|rm|default
#   delegate providers
#   delegate help
set -euo pipefail

# FIRST, before anything reads a key. Bash honours an inherited SHELLOPTS, so
# `env SHELLOPTS=xtrace delegate ...` turns tracing on for this whole script and
# prints every assignment to stderr — including `key=<the actual key>`, and into
# the stream that `--json 2>&1` collects. Verified on this machine. BASH_ENV and
# ENV are the same shape of problem: a file the caller chooses, sourced before
# the script runs. CDPATH is the third: it makes a later `cd` into a relative
# directory land somewhere else and print the path, which both misplaces the run
# and corrupts `--json`.
set +x +v
unset -v SHELLOPTS BASH_ENV ENV CDPATH 2>/dev/null || true

# Exported FUNCTIONS, and here rather than next to the environment wipe further
# down, because this script itself runs grep, ls and git long before it gets
# there. A function arriving in the environ as `BASH_FUNC_<name>%%` is imported
# by bash and WINS over the binary of the same name, so a parent with
# `export -f grep` was already executing its own code inside this script —
# verified, it printed instead of grepping — and the same function then crossed
# into the delegated run, where `Bash(grep:*)` is allowed on the read-only
# floor. `compgen -e` lists variables only and `unset -v` does not touch these,
# which is why the wipe below is not enough on its own.
_dg_fn=''
while read -r _dg_fn _dg_fn _dg_fn; do
  [[ -n $_dg_fn ]] && { unset -f "$_dg_fn" 2>/dev/null || true; }
done < <(declare -Fx)
unset -v _dg_fn

# This script's own namespace, cleared of anything the parent exported into it.
# `_DG_X_KEY` holds the account key and `_DG_X_*` the exec's argv; assigning to a
# name the parent had already EXPORTED would put those values in the child's
# environment under that name, which is the one leak the build-from-allowlist
# rule exists to prevent. The `DG_` names are listed one by one rather than
# taken as a prefix: `DG_` is not reserved, and an MCP entry may perfectly well
# ask to forward something called DG_SOMETHING.
for _dg_fn in $(compgen -e); do
  case "$_dg_fn" in
    _DG_*|_dg_*) unset -v "$_dg_fn" 2>/dev/null || true ;;
    DG_ROOT|DG_BIN|DG_LINK|DG_TOOLS|DG_ALLOWED|DG_RULES|DG_MCP_JSON|DG_MCP_TOOLS|DG_MCP_ENV|DG_MCP_RULES)
      unset -v "$_dg_fn" 2>/dev/null || true ;;
  esac
done
unset -v _dg_fn

# Resolve the real script location so the `dg` symlink finds lib/ too.
DG_BIN="${BASH_SOURCE[0]}"
while [[ -L "$DG_BIN" ]]; do
  DG_LINK="$(readlink "$DG_BIN")"
  [[ "$DG_LINK" == /* ]] && DG_BIN="$DG_LINK" || DG_BIN="$(dirname "$DG_BIN")/$DG_LINK"
done
DG_ROOT="$(cd "$(dirname "$DG_BIN")/.." && pwd)"

PROVIDERS_DIR="${DELEGATE_PROVIDERS_DIR:-$DG_ROOT/providers.d}"

# shellcheck source=../lib/config.sh
source "$DG_ROOT/lib/config.sh"
# shellcheck source=../lib/accounts.sh
source "$DG_ROOT/lib/accounts.sh"
# shellcheck source=../lib/permissions.sh
source "$DG_ROOT/lib/permissions.sh"
# shellcheck source=../lib/mcp.sh
source "$DG_ROOT/lib/mcp.sh"

if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
  B=$'\033[1m'; D=$'\033[2m'; R=$'\033[0m'
  GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RED=$'\033[31m'; CYAN=$'\033[36m'
else
  B=''; D=''; R=''; GREEN=''; YELLOW=''; RED=''; CYAN=''
fi

die()  { printf '%s✗%s %s\n' "$RED" "$R" "$*" >&2; exit 1; }

# Joins stdin lines with ", ". Not `paste -sd', '`: paste CYCLES through the
# delimiter list rather than repeating it, so two items join with a bare comma
# and three alternate ", " and ",".
join_lines() { paste -sd, - | sed 's/,/, /g'; }
warn() { printf '%s!%s %s\n' "$YELLOW" "$R" "$*" >&2; }
ok()   { printf '%s✓%s %s\n' "$GREEN" "$R" "$*" >&2; }

usage() {
  cat >&2 <<EOF
${B}delegate${R} — manda trabajo de código acotado a un modelo más barato ${D}(alias: dg)${R}

${B}USO${R}
  ${CYAN}delegate${R} <proveedor> [opciones] "tarea"      agente con herramientas
  ${CYAN}delegate${R} <proveedor> chat [opciones] "texto"  una pregunta, sin herramientas
  ${CYAN}delegate account${R} <proveedor> <acción>         cuentas (API keys)
  ${CYAN}delegate mcp list${R}                              servidores MCP declarados
  ${CYAN}delegate providers${R}                            proveedores configurados
  ${CYAN}delegate help${R}                                 esta ayuda

${B}ACCESO${R} ${D}(el más angosto que alcance para la tarea)${R}
  ${D}(sin flag)${R}      solo lectura: Read y shell de lectura
  ${CYAN}--edit${R}          agrega escritura de archivos
  ${CYAN}--bash${R}          agrega shell sin restricción
  ${CYAN}--mcp${R} <srv>     agrega las herramientas de LECTURA de ese servidor MCP
  ${CYAN}--mcp-write${R} <s> agrega también las de escritura
                  ${D}Repetibles. Sin ellos, la corrida no alcanza ningún MCP.${R}

${B}OPCIONES${R}
  ${CYAN}--account${R} <n>   usa la key de esa cuenta, sin tocar la activa
  ${CYAN}--dir${R} <ruta>    directorio de trabajo ${D}(default: el actual)${R}
  ${CYAN}--model${R} <id>    pisa el modelo del proveedor
  ${CYAN}--timeout${R} <s>   segundos ${D}(default: el del proveedor)${R}
  ${CYAN}--json${R}          salida JSON: resultado, costo, sesión

${B}CUENTAS${R}
  delegate account <proveedor> list
  delegate account <proveedor> add <cuenta>      ${D}pide la key sin eco${R}
  delegate account <proveedor> use <cuenta>      ${D}cambia la activa (global)${R}
  delegate account <proveedor> rm <cuenta>
  delegate account <proveedor> default [cuenta]  ${D}default por invocación${R}

  La cuenta activa es global: otra sesión puede cambiarla a mitad de tu corrida.
  Un pipeline que dependa de una cuenta específica pasa ${CYAN}--account${R}.

${B}QUÉ NO DELEGAR${R}
  Secrets, PII de clientes, datos o consultas de producción, y decisiones de
  dinero, seguridad o compliance. Lo que sale hacia el proveedor es el prompt y
  todo archivo que el agente lea en el directorio de trabajo.
EOF
}

# ─── configuración del proveedor ─────────────────────────────────────────────

declare -A CFG=()

load_provider() {
  # Two statements on purpose: in a single `local`, every word is expanded before
  # any of them is assigned, so `file="$PROVIDERS_DIR/$id"` would read an `id`
  # that does not exist yet — fatal under `set -u`.
  local id="$1" parsed k v
  local file="$PROVIDERS_DIR/$id"
  if [[ ! -f "$file" ]]; then
    local known
    known="$(dg_config_providers "$PROVIDERS_DIR" | join_lines)"
    die "proveedor desconocido: ${B}${id}${R}. Configurados: ${known:-ninguno}"
  fi
  parsed="$(dg_config_parse "$file" "$id")" || exit 2
  while IFS=$'\t' read -r k v; do
    [[ -n "$k" ]] && CFG["$k"]="$v"
  done <<< "$parsed"
  # Defaults. The parser deliberately omits unset keys instead of inventing
  # them, so this is the one place a default exists.
  CFG[key_pattern]="${CFG[key_pattern]:-api_key.%s}"
  CFG[timeout]="${CFG[timeout]:-1800}"
  CFG[caps]="${CFG[caps]:-$(dg_perm_caps_default)}"
  CFG[small_model]="${CFG[small_model]:-${CFG[model]}}"
}

# ─── cuentas ─────────────────────────────────────────────────────────────────

# Resolution order, most explicit first. A concrete account always beats the
# global active symlink, which another session can change under us.
resolve_account_path() {
  local requested="$1" name
  if [[ -n "$requested" ]]; then
    name="$requested"
  elif [[ -n "${DELEGATE_ACCOUNT:-}" ]]; then
    name="$DELEGATE_ACCOUNT"
  elif name="$(dg_account_default_get "${CFG[key_dir]}" 2>/dev/null)" && [[ -n "$name" ]]; then
    :
  elif [[ -n "${CFG[default_account]:-}" ]]; then
    name="${CFG[default_account]}"
  elif name="$(dg_account_active "${CFG[key_dir]}" "${CFG[key_pattern]}" 2>/dev/null)" && [[ -n "$name" ]]; then
    :
  else
    local avail
    avail="$(dg_account_list "${CFG[key_dir]}" "${CFG[key_pattern]}" | join_lines)"
    if [[ -n "$avail" ]]; then
      die "no hay cuenta activa. Elige una con ${B}delegate account $PROVIDER use <cuenta>${R} o pasa ${B}--account${R}. Configuradas: $avail"
    fi
    die "no hay ninguna key configurada para ${B}${PROVIDER}${R}. Agrega una: ${B}delegate account $PROVIDER add <cuenta>${R}"
  fi
  dg_account_path "${CFG[key_dir]}" "${CFG[key_pattern]}" "$name" || exit 2
}

cmd_account() {
  local provider="${1:-}" action="${2:-list}" name="${3:-}"
  [[ -n "$provider" ]] || die "falta el proveedor. Uso: delegate account <proveedor> <acción>"
  load_provider "$provider"
  local kd="${CFG[key_dir]}" kp="${CFG[key_pattern]}"

  case "$action" in
    list|ls)
      local active current path fp
      active="$(dg_account_active "$kd" "$kp" 2>/dev/null || true)"
      current="$(dg_account_default_get "$kd" 2>/dev/null || true)"
      local found=0
      while read -r n; do
        [[ -n "$n" ]] || continue
        found=1
        path="$(dg_account_path "$kd" "$kp" "$n")"
        fp="$(dg_account_fingerprint "$path" 2>/dev/null || echo '????????')"
        local marks=''
        [[ "$n" == "$active" ]] && marks+=" ${GREEN}activa${R}"
        [[ "$n" == "$current" ]] && marks+=" ${CYAN}default${R}"
        printf '  %s%-16s%s %s%s%s%s\n' "$B" "$n" "$R" "$D" "$fp" "$R" "$marks"
      done < <(dg_account_list "$kd" "$kp")
      if (( ! found )); then
        warn "no hay cuentas configuradas para $provider"
        printf '    %sagrega una:%s delegate account %s add <cuenta>\n' "$D" "$R" "$provider" >&2
        return 1
      fi
      ;;
    add)
      [[ -n "$name" ]] || die "falta el nombre. Uso: delegate account $provider add <cuenta>"
      dg_account_add "$kd" "$kp" "$name"
      local path; path="$(dg_account_path "$kd" "$kp" "$name")"
      ok "guardada como ${B}${name}${R} ${D}(huella $(dg_account_fingerprint "$path"), permisos 600)${R}"
      # First key configured becomes active: there is nothing to disambiguate.
      if ! dg_account_active "$kd" "$kp" >/dev/null 2>&1; then
        dg_account_activate "$kd" "$path"
        ok "quedó activa por ser la primera"
      else
        printf '    %sactívala:%s delegate account %s use %s\n' "$D" "$R" "$provider" "$name" >&2
      fi
      ;;
    use)
      [[ -n "$name" ]] || die "falta el nombre. Uso: delegate account $provider use <cuenta>"
      local path; path="$(dg_account_path "$kd" "$kp" "$name")" || exit 2
      # stdout discarded: validate prints the RESOLVED path, and `use` has to
      # point `api_key` at the account file by its own name, not at whatever
      # that file happens to resolve to.
      dg_account_validate "$kd" "$path" >/dev/null || die "no puedo usar la cuenta '$name'"
      dg_account_activate "$kd" "$path"
      ok "cuenta activa: ${B}${name}${R}"
      ;;
    rm|remove)
      [[ -n "$name" ]] || die "falta el nombre. Uso: delegate account $provider rm <cuenta>"
      local path; path="$(dg_account_path "$kd" "$kp" "$name")" || exit 2
      [[ -e "$path" ]] || die "no existe la cuenta '$name'"
      printf '%sBorrar la key de%s %s%s%s. Escribe el nombre para confirmar: ' \
        "$YELLOW" "$R" "$B" "$name" "$R" >&2
      local confirm; read -r confirm
      [[ "$confirm" == "$name" ]] || die "no coincide, no borré nada"
      local rc=0
      dg_account_remove "$kd" "$kp" "$name" || rc=$?
      if (( rc == 10 )); then
        ok "borrada la cuenta ${B}${name}${R}"
        local resto; resto="$(dg_account_list "$kd" "$kp" | join_lines)"
        if [[ -n "$resto" ]]; then
          warn "era la activa: no hay ninguna activa, y las corridas sin --account van a fallar hasta que elijas otra"
          printf '    %sdisponibles:%s %s\n' "$D" "$R" "$resto" >&2
        else
          # `|| true` no alcanzaba: esto era el ÚLTIMO comando de la función en
          # el camino de éxito, así que un `[[ -n "$resto" ]] &&` que fallara se
          # propagaba como return 1 y `set -e` mataba el script después de haber
          # borrado la key. El exit code mentía sobre una operación que salió
          # bien.
          warn "era la activa y no queda ninguna: agrega otra con ${B}delegate account ${provider} add <cuenta>${R}"
        fi
      elif (( rc != 0 )); then
        exit "$rc"
      else
        ok "borrada la cuenta ${B}${name}${R}"
      fi
      ;;
    default)
      if [[ -z "$name" ]]; then
        dg_account_default_get "$kd" || die "no hay cuenta default para $provider"
      else
        local path; path="$(dg_account_path "$kd" "$kp" "$name")" || exit 2
        dg_account_validate "$kd" "$path" >/dev/null || die "no puedo usar la cuenta '$name'"
        dg_account_default_set "$kd" "$name"
        ok "cuenta default de ${B}${provider}${R}: ${B}${name}${R}"
      fi
      ;;
    *)
      die "acción desconocida: $action ${D}(list | add | use | rm | default)${R}"
      ;;
  esac
}

cmd_providers() {
  local id parsed k v
  local found=0
  while read -r id; do
    [[ -n "$id" ]] || continue
    found=1
    declare -A P=()
    if parsed="$(dg_config_parse "$PROVIDERS_DIR/$id" "$id" 2>/dev/null)"; then
      while IFS=$'\t' read -r k v; do [[ -n "$k" ]] && P["$k"]="$v"; done <<< "$parsed"
      printf '  %s%-10s%s %s%s%s\n' "$B" "$id" "$R" "$D" "${P[model]:-?}" "$R"
      printf '      %scaps:%s %s\n' "$D" "$R" "${P[caps]:-$(dg_perm_caps_default)}"
      [[ -n "${P[residency]:-}" ]] && printf '      %sdatos:%s %s\n' "$D" "$R" "${P[residency]}"
    else
      printf '  %s%-10s%s %sconfig inválida%s\n' "$B" "$id" "$R" "$RED" "$R"
    fi
    unset P
  done < <(dg_config_providers "$PROVIDERS_DIR")
  (( found )) || { warn "no hay proveedores en $PROVIDERS_DIR"; return 1; }
}

cmd_mcp() {
  # Read-only: this lists what the machine owner declared, and listing is the
  # only thing it does. Nothing here enables a server — that happens per
  # invocation, with --mcp, and only for a server named by hand.
  local sub="${1:-list}"
  [[ "$sub" == 'list' ]] || die "uso: delegate mcp list"

  local dir id parsed k v found=0
  dir="$(dg_mcp_dir)"
  if [[ ! -d "$dir" ]]; then
    warn "no hay directorio de servidores MCP en $dir"
    printf '  %sun archivo por servidor, formato clave<TAB>valor; hay ejemplos en examples/mcp.d/%s\n' "$D" "$R"
    return 1
  fi

  while read -r id; do
    [[ -n "$id" ]] || continue
    found=1
    declare -A M=()
    if parsed="$(dg_mcp_parse "$dir/$id" "$id" 2>/dev/null)"; then
      while IFS=$'\t' read -r k v; do [[ -n "$k" ]] && M["$k"]="$v"; done <<< "$parsed"
      printf '  %s%-12s%s %s%s%s\n' "$B" "$id" "$R" "$D" "${M[transport]:-?}" "$R"
      [[ -n "${M[description]:-}" ]] && printf '      %s%s%s\n' "$D" "${M[description]}" "$R"
      # Counts, not the lists: the point of this view is which servers exist and
      # whether writing is even on offer, not to reproduce an allowlist that
      # only matters at resolve time.
      printf '      %slectura:%s %s' "$D" "$R" "$(printf '%s' "${M[tools_read]:-}" | tr ',' '\n' | grep -c .)"
      if [[ -n "${M[tools_write]:-}" ]]; then
        printf '   %sescritura:%s %s %s(--mcp-write)%s' "$D" "$R" \
          "$(printf '%s' "${M[tools_write]}" | tr ',' '\n' | grep -c .)" "$D" "$R"
      fi
      printf '\n'
      [[ -n "${M[env_passthrough]:-}" ]] &&
        printf '      %sreenvía del shell:%s %s\n' "$D" "$R" "${M[env_passthrough]}"
      # `rules` in full, not a count. It is the one value in an entry that
      # changes what the delegated model is TOLD, and it is appended after the
      # run's own rules, which is the strongest position in the prompt. An
      # entry that says "ignora las reglas anteriores" is a legitimate thing to
      # write in this format and an illegitimate thing to keep out of sight, so
      # the only defence is that whoever runs `mcp list` can read it.
      [[ -n "${M[requires_file]:-}" ]] &&
        printf '      %snecesita:%s %s\n' "$D" "$R" "${M[requires_file]}"
      [[ -n "${M[rules]:-}" ]] &&
        printf '      %sle dice al modelo:%s %s\n' "$D" "$R" "${M[rules]}"
    else
      # The reason went to /dev/null on purpose: a listing that prints one
      # entry's parse error in the middle of the others is unreadable. The
      # pointer is enough, and `--mcp <id>` prints the real reason.
      printf '  %s%-12s%s %sentrada inválida%s %s(delegate <proveedor> --mcp %s dice por qué)%s\n' \
        "$B" "$id" "$R" "$RED" "$R" "$D" "$id" "$R"
    fi
    unset M
  done < <(dg_mcp_servers "$dir")

  # dg_mcp_servers drops a file whose NAME is not a valid id, which is right —
  # nobody could ask for it with --mcp anyway. But dropping it silently from
  # this listing is how someone stares at a file they wrote and wonders why it
  # does nothing. Named, not ignored.
  local path base bad=()
  for path in "$dir"/*; do
    [[ -f "$path" ]] || continue
    base="${path##*/}"
    dg_mcp_servers "$dir" | grep -qxF -- "$base" || bad+=("$base")
  done
  if (( ${#bad[@]} )); then
    warn "ignorados por tener un nombre que no es un id válido (^[a-z][a-z0-9-]{0,31}$): $(printf '%s\n' "${bad[@]}" | join_lines)"
  fi

  (( found )) || { warn "no hay servidores MCP declarados en $dir"; return 1; }
}

# ─── corrida delegada ────────────────────────────────────────────────────────

cmd_run() {
  local mode='agent'
  if [[ "${1:-}" == 'chat' ]]; then mode='chat'; shift; fi

  local want_edit=0 want_bash=0 account='' workdir="$PWD"
  local format='text' timeout_s='' model=''
  # Repeatable, so they accumulate as comma-separated lists for lib/mcp.sh.
  local mcp_read='' mcp_write=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --edit)        want_edit=1; shift ;;
      --bash)        want_bash=1; shift ;;
      --mcp)         mcp_read="${mcp_read:+$mcp_read,}${2:?--mcp necesita un servidor}"; shift 2 ;;
      --mcp-write)   mcp_write="${mcp_write:+$mcp_write,}${2:?--mcp-write necesita un servidor}"; shift 2 ;;
      --json)        format='json'; shift ;;
      --account)     account="${2:?--account necesita un nombre}"; shift 2 ;;
      --dir)         workdir="${2:?--dir necesita una ruta}"; shift 2 ;;
      --model)       model="${2:?--model necesita un id}"; shift 2 ;;
      --timeout)     timeout_s="${2:?--timeout necesita segundos}"; shift 2 ;;
      --)            shift; break ;;
      -*)            die "opción desconocida: $1" ;;
      *)             break ;;
    esac
  done

  [[ $# -gt 0 ]] || die "falta la tarea. Uso: delegate $PROVIDER [opciones] \"tarea\""
  local prompt="$*"

  [[ -d "$workdir" ]] || die "no existe el directorio: $workdir"

  if [[ "$mode" == 'chat' ]]; then
    # chat is a mode, not a lesser agent: no tools at all, so a permission flag
    # asked for here was a misunderstanding worth surfacing, not something to
    # quietly ignore.
    (( want_edit || want_bash )) && die "chat no tiene herramientas: quita --edit y --bash, o usa el modo agente"
    [[ -n "$mcp_read$mcp_write" ]] && die "chat no tiene herramientas: quita --mcp y --mcp-write, o usa el modo agente"
  fi

  [[ -n "$timeout_s" ]] || timeout_s="${CFG[timeout]}"
  [[ "$timeout_s" =~ ^[0-9]+$ && "$timeout_s" -ge 1 ]] || die "--timeout debe ser un entero de segundos"
  [[ -n "$model" ]] || model="${CFG[model]}"

  # Permissions before the key: a run that is going to be refused must be
  # refused before anything reads a secret from disk.
  DG_MCP_JSON=''
  DG_MCP_TOOLS=''
  DG_MCP_RULES=''
  DG_MCP_ENV=()
  DG_MCP_NEED=()
  if [[ "$mode" == 'agent' ]]; then
    # Which servers exist is the machine owner's declaration; which ones this run
    # reaches is the invocation's. Resolving the entries first means an unknown
    # server name is refused before the ceiling is even consulted, and long
    # before any key is read.
    local want_mcp=0 want_mcp_write=0
    if [[ -n "$mcp_read$mcp_write" ]]; then
      dg_mcp_resolve "$(dg_mcp_dir)" "$mcp_read" "$mcp_write" || exit 2
      want_mcp=1
      [[ -n "$mcp_write" ]] && want_mcp_write=1
      # Two families are refused outright.
      #
      # ANTHROPIC_* and CLAUDE_CODE_* are what this run itself defines. The
      # exports that pin the endpoint, the model and the key are applied after
      # the passthrough, so today an entry naming one of them would be
      # overwritten rather than win — but the refusal is not about ordering: a
      # server asking for a name the run owns is asking for something it cannot
      # have, and quietly handing it a different value would be its own
      # surprise.
      #
      # The second family is the one that matters more now that the child's
      # environment is built from an allowlist: the passthrough is the ONLY
      # channel through which anything from this shell crosses. A name whose
      # value the harness treats as CODE turns that channel into code execution
      # inside the delegated process — NODE_OPTIONS=--require=... loads a file
      # of the entry author's choosing, LD_PRELOAD the same for any binary the
      # run spawns, GIT_EXTERNAL_DIFF and GIT_SSH_COMMAND are commands, and
      # BASH_ENV is sourced by every non-interactive bash. No MCP server needs
      # any of them forwarded. Credentials are NOT on this list on purpose:
      # forwarding a token is what the feature is for, so the answer there is
      # visibility, not refusal — see the line printed below.
      local rn
      for rn in ${DG_MCP_ENV[@]+"${DG_MCP_ENV[@]}"}; do
        case "$rn" in
          ANTHROPIC_*|CLAUDE_CODE_*)
            printf '%s✗%s %s\n' "$RED" "$R" \
              "un servidor MCP pidió reenviar ${B}${rn}${R}, que esta corrida define; quita ese nombre de env_passthrough" >&2
            exit 2 ;;
          LD_*|NODE_OPTIONS|NODE_REPL_EXTERNAL_MODULE|BASH_ENV|ENV|SHELLOPTS|BASHOPTS|IFS|PATH|HOME|PYTHONPATH|PYTHONSTARTUP|PERL5LIB|PERL5OPT|RUBYOPT|GIT_SSH_COMMAND|GIT_EXTERNAL_DIFF|GIT_PAGER|GIT_EDITOR|PAGER|EDITOR|VISUAL)
            printf '%s✗%s %s\n' "$RED" "$R" \
              "un servidor MCP pidió reenviar ${B}${rn}${R}: su valor se interpreta como código dentro de la corrida delegada, así que no se reenvía nunca" >&2
            exit 2 ;;
        esac
      done

      # Preconditions of the entries that were asked for. An entry whose `rules`
      # say "read X first" is broken in a tree that has no X, and a delegated
      # run told to read a file that is not there does not stop — it improvises,
      # which is the expensive failure. Checked here, before the key is read,
      # like every other refusal.
      #
      # A relative path resolves against the working directory of the run, which
      # is `--dir` and is where the child will look for it too. Resolved with
      # the same containment rule the key files use, so a precondition cannot
      # point outside the tree under review; an absolute path is allowed and is
      # a precondition of the machine, not of the tree.
      local need nid npath nfull nreal nroot
      nroot="$(readlink -f -- "$workdir")" || die "no puedo resolver el directorio de trabajo $workdir"
      for need in ${DG_MCP_NEED[@]+"${DG_MCP_NEED[@]}"}; do
        nid="${need%%$'\t'*}"
        npath="${need#*$'\t'}"
        if [[ "$npath" == /* ]]; then
          nfull="$npath"
        else
          nfull="$nroot/$npath"
        fi
        if [[ ! -e "$nfull" ]]; then
          printf '%s✗%s %s\n' "$RED" "$R" \
            "el servidor MCP ${B}${nid}${R} necesita ${B}${npath}${R}, que no existe en $([[ "$npath" == /* ]] && printf 'esta máquina' || printf '%s' "$nroot")" >&2
          printf '    %sestá declarado en su requires_file; quita --mcp %s o corre desde un árbol que lo tenga%s\n' \
            "$D" "$nid" "$R" >&2
          exit 2
        fi
        # Relative paths only: an absolute one was already a deliberate choice
        # about a path outside the tree.
        if [[ "$npath" != /* ]]; then
          nreal="$(readlink -f -- "$nfull")" || die "no puedo resolver $npath"
          [[ "$nreal" == "$nroot" || "$nreal" == "$nroot"/* ]] ||
            die "el requires_file '$npath' del servidor $nid sale del directorio de trabajo"
        fi
      done
    fi
    dg_perm_resolve "${CFG[caps]}" "$want_edit" "$want_bash" \
      "$want_mcp" "$want_mcp_write" "${DG_MCP_RULES:-}" || exit 2
    # The MCP allowlist is appended here, not inside lib/permissions.sh: that
    # file owns the local tool lattice and must stay ignorant of which servers
    # exist.
    [[ -n "$DG_MCP_TOOLS" ]] && DG_ALLOWED="$DG_ALLOWED,$DG_MCP_TOOLS"
  else
    DG_TOOLS=''
    DG_ALLOWED=''
    DG_RULES='Responde en español venezolano neutro (tú, nunca voseo). No tienes herramientas: no puedes leer archivos ni ejecutar nada. Responde solo con lo que te den en el mensaje. Si te falta información para responder, dilo en vez de suponerla.'
  fi

  # ── la key: se lee UNA sola vez, acá, después de validar todo lo demás ──
  # Entre resolver la cuenta y abrir el archivo hay una carrera: otro proceso
  # puede cambiar el symlink de la activa. Leerla una vez y en este punto acota
  # esa ventana a lo mínimo, y deja la corrida inmune a un cambio posterior.
  # `+x` is not decoration: a `local` that shadows an exported variable of the
  # same name KEEPS the export attribute, so with `export key=...` in the
  # caller's shell the account key silently joined the environment of every
  # helper this script runs afterwards — including the `grep` in the process
  # substitution, which is not the child. Verified on Bash 5.2.
  local +x key_path key
  key_path="$(resolve_account_path "$account")"
  # The path validate PRINTS, not the one it was given: the mode, owner, type
  # and size checks were all made against the resolved file, and reopening the
  # argument would follow the symlink a second time.
  key_path="$(dg_account_validate "${CFG[key_dir]}" "$key_path")" || exit 1
  key="$(dg_account_read "$key_path")"
  [[ -n "$key" ]] || die "la key en $key_path está vacía"

  # Other AI CLIs are unreachable from a delegated run. Invoking codex or claude
  # from here spent the scarcest quota on reviews nobody asked for, and a rule in
  # the prompt did not stop it. Stubs first in PATH make those calls fail; claude
  # itself is resolved to an absolute path before PATH changes.
  local claude_bin stub_dir tool
  claude_bin="$(command -v claude)" || die "no encuentro el binario de claude en el PATH"
  stub_dir="${XDG_CACHE_HOME:-$HOME/.cache}/delegate/stubs"
  # 700 and owner-checked. This directory goes FIRST in the child's PATH, and
  # its location comes from XDG_CACHE_HOME, an inherited variable. Pointed at a
  # shared writable directory, anything a third party precreated there as
  # `git`, `grep` or `node` would run ahead of the real binary inside the
  # delegated process. Refused rather than repaired: silently relocating the
  # stubs would hide the fact that the cache path is not the caller's.
  mkdir -p -m 700 "$stub_dir"
  [[ -O "$stub_dir" ]] || die "el directorio de stubs $stub_dir no es tuyo; revisa XDG_CACHE_HOME"
  chmod 700 "$stub_dir"
  for tool in codex claude delegate dg; do
    printf '#!/bin/sh\necho "delegate: %s está bloqueado en tareas delegadas" >&2\nexit 126\n' \
      "$tool" > "$stub_dir/$tool"
    chmod +x "$stub_dir/$tool"
  done
  export PATH="$stub_dir:$PATH"

  local claude_args=(
    -p
    --bare
    # --bare skips hooks and the like, but on its own it still resolves a
    # `/skill-name` in the prompt against the user's installed skills, and
    # --add-dir only ADDS access rather than confining anything. --restricted
    # ignores the user, project and local settings files and confines the file
    # tools to the working directories; --disable-slash-commands closes the
    # skill route. Bash survives both because --tools names it, which is why
    # the read-only floor below is the thing that has to hold.
    --restricted
    --disable-slash-commands
    --setting-sources "project,local"
    --strict-mcp-config
    --permission-mode "dontAsk"
    --output-format "$format"
  )
  if [[ "$mode" == 'agent' ]]; then
    claude_args+=(
      --add-dir "$workdir"
      --tools "$DG_TOOLS"
      --allowedTools "$DG_ALLOWED"
    )
  else
    claude_args+=(--tools '')
  fi
  # --strict-mcp-config is already above, so with no --mcp-config the child
  # reaches no server at all. This adds one only when a server was requested.
  [[ -n "$DG_MCP_JSON" ]] && claude_args+=(--mcp-config "$DG_MCP_JSON")

  # Defence in depth, not a boundary. An allow list matches a command name, so
  # `git diff --output=path` passes the read-only floor and writes a file — two
  # independent reviews found it. Denying the shapes that write raises the cost
  # without pretending to close it: a deny list is prefix matching too, and the
  # honest limit of the floor is written down in CLAUDE.md. It is unconditional
  # only on the floor: `--bash` is unrestricted shell by definition, and denying
  # a form there would be a narrower grant than the one that was asked for.
  if [[ "$mode" == 'agent' ]] && (( ! want_bash )); then
    claude_args+=(--disallowedTools
      'Bash(git diff --output*),Bash(git log --output*),Bash(git show --output*)')
  fi

  # LAST on purpose, and it must stay last. `--tools` and `--allowedTools` are
  # variadic (`<tools...>`): they keep eating arguments until the next option,
  # so a prompt sitting right after them was parsed as one more tool name and
  # the child died with "Input must be provided either through stdin or as a
  # prompt argument". Ending on an option that takes exactly one value is what
  # makes the positional prompt reach the child. Anything appended after this
  # has to take exactly one value too.
  claude_args+=(--append-system-prompt "$DG_RULES")

  # Names the entries asked to forward. Values are never in the config: the
  # child inherits whatever this shell has under that name, and a name that is
  # unset here is simply not forwarded — the server will say what it needs.
  local passthrough=() n fwd=()
  for n in ${DG_MCP_ENV[@]+"${DG_MCP_ENV[@]}"}; do
    if [[ -n "${!n+set}" ]]; then
      passthrough+=("$n=${!n}")
      fwd+=("$n")
    else
      warn "el servidor MCP pidió reenviar ${B}${n}${R}, que no está definida en este shell"
    fi
  done
  # Said out loud, every time. The tool used to warn about a name it could NOT
  # forward and stay silent about the ones it did, which is backwards: since the
  # child's environment is built from an allowlist, this list is the complete
  # set of things from this shell that cross into the delegated run. A token
  # leaving for the cheap provider's endpoint should not be the quiet case.
  # Names only — a value never appears in this output.
  if (( ${#fwd[@]} )); then
    warn "se reenvían al hijo, por pedido de un servidor MCP: ${B}$(printf '%s\n' "${fwd[@]}" | join_lines)${R}"
  fi

  cd "$workdir"
  # Harmless notice from Claude Code when it titles a session with a model it
  # does not know. It goes to stderr, but it dirties any `2>&1` over --json.
  exec 2> >(grep --line-buffered -v '\[claude-code:unrecognized_model\]' >&2)

  # The environment is BUILT, not inherited. `env -u A -u B VAR=x cmd` keeps
  # everything else the parent had, so GITHUB_TOKEN, AWS_*, NODE_OPTIONS and
  # any exported function reached the delegated run even with no flags at all —
  # which is the opposite of what invariant 3 claims. `env -i` starts from
  # nothing and only what is named below gets through.
  #
  # Keep the values worth carrying over, then drop every exported name and put
  # only these back. These are what the harness needs to run at all, and none is
  # a credential: HOME (where node and claude keep state), PATH (already
  # rewritten above so the stubs come first), the identity and locale that
  # tooling reads, TMPDIR, and the CA overrides, which matter behind a corporate
  # proxy and carry a path, not a secret.
  #
  # Everything the exec needs is published in `_DG_X_*` globals and this
  # function RETURNS, so that the wipe below runs in a scope where none of these
  # names is local any more. That is not style: inside a function `unset -v key`
  # removes the LOCAL binding and leaves it in an "unset local" state that masks
  # the caller's variable instead of exposing it, so a parent that exported
  # `key`, `prompt`, `model` or `claude_bin` — every one of them a plain name
  # this function declares — survived the wipe and reached the child. Verified,
  # `export -n` behaves the same way. With cmd_run returned, its locals are gone
  # and the unset reaches the real thing.
  _DG_X_BIN="$claude_bin"
  _DG_X_PROMPT="$prompt"
  _DG_X_TIMEOUT="$timeout_s"
  _DG_X_ENDPOINT="${CFG[endpoint]}"
  _DG_X_MODEL="$model"
  _DG_X_SMALL="${CFG[small_model]}"
  _DG_X_AUTHENV="${CFG[auth_env]}"
  _DG_X_KEY="$key"
  _DG_X_ARGS=("${claude_args[@]}")

  # Resolved here, while the parent's values are still readable: the wipe is
  # about to remove them.
  _DG_X_KEEP=()
  local kn
  for kn in HOME PATH USER LOGNAME SHELL TERM LANG LC_ALL TZ TMPDIR \
            SSL_CERT_FILE SSL_CERT_DIR NODE_EXTRA_CA_CERTS; do
    [[ -n "${!kn+set}" ]] && _DG_X_KEEP+=("$kn=${!kn}")
  done
  _DG_X_PASS=(${passthrough[@]+"${passthrough[@]}"})
  return 0
}

# ─── el exec del hijo ────────────────────────────────────────────────────────
#
# Se llama desde el despacho, DESPUÉS de que cmd_run retornó. Todos sus locals
# llevan el prefijo `_dg_` y el wipe lo excluye, así que ningún nombre que el
# padre pueda exportar queda tapado por un local de aquí.
dg_exec_child() {
  local _dg_n _dg_pair

  # The wipe. `env -u A -u B VAR=x cmd` keeps everything else the parent had, so
  # GITHUB_TOKEN, AWS_*, NODE_OPTIONS and any exported function reached the
  # delegated run even with no flags at all — the opposite of what invariant 3
  # claims. Clearing the export list here, rather than passing `env -i` a list
  # of assignments, is what keeps the key out of an argv (see below).
  for _dg_n in $(compgen -e); do
    [[ $_dg_n == _dg_* || $_dg_n == _DG_* || $_dg_n == CFG ]] && continue
    unset -v "$_dg_n" 2>/dev/null || true
  done

  # Exported functions were already dropped at the top of the script, before
  # anything ran a single external command; see the note there.

  for _dg_pair in ${_DG_X_KEEP[@]+"${_DG_X_KEEP[@]}"} ${_DG_X_PASS[@]+"${_DG_X_PASS[@]}"}; do
    export "${_dg_pair?}"
  done

  export ANTHROPIC_BASE_URL="$_DG_X_ENDPOINT"
  export ANTHROPIC_MODEL="$_DG_X_MODEL"
  export ANTHROPIC_DEFAULT_OPUS_MODEL="$_DG_X_MODEL"
  export ANTHROPIC_DEFAULT_SONNET_MODEL="$_DG_X_MODEL"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL="$_DG_X_SMALL"
  export CLAUDE_CODE_SUBAGENT_MODEL="$_DG_X_SMALL"

  # The key enters THIS shell's environment and the exec inherits it. It is
  # never an argument, not even to `env`: `env ANTHROPIC_API_KEY=<key> ...` puts
  # the key in env's own argv, and /proc/<pid>/cmdline is world-readable on
  # Linux, so until env replaced itself any user on the machine could read it.
  # `export` with a computed name has no such window, and dropping `env`
  # altogether means one less process that ever saw it.
  export "${_DG_X_AUTHENV}=$_DG_X_KEY"

  exec timeout "$_DG_X_TIMEOUT" \
    "$_DG_X_BIN" "${_DG_X_ARGS[@]}" "$_DG_X_PROMPT" \
    < /dev/null  # sin terminal, `claude -p` espera 3 s por stdin antes de arrancar
}

# ─── despacho ────────────────────────────────────────────────────────────────

case "${1:-help}" in
  help|--help|-h) usage ;;
  providers)      cmd_providers ;;
  mcp)            shift; cmd_mcp "$@" ;;
  account)        shift; cmd_account "$@" ;;
  -*)             die "las opciones van después del proveedor: delegate <proveedor> $1 ..." ;;
  *)
    PROVIDER="$1"; shift
    load_provider "$PROVIDER"
    # Dos pasos a propósito: cmd_run publica en `_DG_X_*` y retorna, para que el
    # wipe del environment corra sin sus locals vivos. Ver la nota en cmd_run.
    cmd_run "$@"
    dg_exec_child
    ;;
esac
