#!/bin/bash -p
# delegate — manda trabajo de código acotado a un modelo más barato.
#
# Corre el harness de Claude Code en headless contra el endpoint
# Anthropic-compatible del proveedor, fijándolo SOLO en este proceso: la sesión
# principal no se toca. Los invariantes que esto sostiene están en CLAUDE.md.
#
#   delegate deepseek "revisa src/auth.ts y lista los error paths"
#   delegate deepseek --edit --bash "arregla y corre los tests"
#   delegate qwen --timeout 2400 "segunda opinión de este PR"
#   delegate deepseek chat "explica este regex"
#
#   delegate account deepseek list|add|use|rm|default
#   delegate providers
#   delegate help
#
# The shebang is `/bin/bash -p`, a fixed path and privileged mode, and both
# matter. Everything below this comment runs AFTER bash has processed its own
# startup, and three things the caller controls acted there, before any
# cleanup in this file could: BASH_ENV (a file sourced before line one), an
# exported function named `set` (imported, then run by the cleanup's own `set`
# call — twice, verified), and SHELLOPTS (xtrace with a PS4 that printed the
# parent's ANTHROPIC_API_KEY; allexport, which re-exported the account key
# through every assignment). Privileged mode skips BASH_ENV and ENV, imports no
# functions and ignores SHELLOPTS, BASHOPTS, CDPATH and GLOBIGNORE from the
# environment. `env bash` would let PATH pick the interpreter, and env passes
# no option portably. Run as `bash bin/delegate`, the shebang is ignored and
# none of this holds; installed and invoked by name, it does.

# FIRST useful line. Privileged mode already ignored an inherited SHELLOPTS, but
# `bash -a delegate` or `bash -x delegate` set the same options from the
# command line: allexport would export `key` through `local +x`, and xtrace
# would print `key=<the actual key>` to the stderr that `--json 2>&1` collects.
set +a +x +v
set -euo pipefail

# BASH_ENV and ENV are already harmless here (privileged mode did not read
# them) and unset so nothing this script runs inherits them. CDPATH makes a
# later `cd` into a relative directory land somewhere else and print the path,
# which both misplaces the run and corrupts `--json`. SHELLOPTS is readonly,
# hence the `|| true`.
unset -v SHELLOPTS BASH_ENV ENV CDPATH 2>/dev/null || true

# Exported FUNCTIONS. Privileged mode already declined to import them; this
# loop is for a run started as `bash bin/delegate`, where the shebang does not
# apply. Here rather than next to the environment wipe further down, because this script itself runs grep, ls and git long before it gets
# there. A function arriving in the environ as `BASH_FUNC_<name>%%` is imported
# by bash and WINS over the binary of the same name, so a parent with
# `export -f grep` was already executing its own code inside this script —
# verified, it printed instead of grepping — and the same function then crossed
# into the delegated run, where `Bash(grep:*)` is allowed on the read-only
# floor. `compgen -e` lists variables only and `unset -v` does not touch these,
# which is why the wipe below is not enough on its own.
_dg_fn=''
while read -r _dg_fn _dg_fn _dg_fn; do
  [[ -n $_dg_fn ]] && { unset -f "$_dg_fn" 2>/dev/null || true; }
done < <(declare -Fx)
unset -v _dg_fn

# This script's own namespace, cleared of anything the parent exported into it.
# `_DG_X_KEY` holds the account key and `_DG_X_*` the exec's argv; assigning to a
# name the parent had already EXPORTED would put those values in the child's
# environment under that name, which is the one leak the build-from-allowlist
# rule exists to prevent. The `DG_` names are listed one by one rather than
# taken as a prefix: `DG_` is not reserved, and an MCP entry may perfectly well
# ask to forward something called DG_SOMETHING.
for _dg_fn in $(compgen -e); do
  case "$_dg_fn" in
    _DG_*|_dg_*) unset -v "$_dg_fn" 2>/dev/null || true ;;
    DG_ROOT|DG_BIN|DG_LINK|DG_TOOLS|DG_ALLOWED|DG_RULES|DG_MCP_JSON|DG_MCP_TOOLS|DG_MCP_ENV|DG_MCP_RULES)
      unset -v "$_dg_fn" 2>/dev/null || true ;;
  esac
done
unset -v _dg_fn

# PATH without empty or relative entries. Both resolve against whatever the
# current directory happens to be, and this script cd's into --dir, the tree
# under review: with `.` in PATH, `command -v claude` came back RELATIVE and the
# tree chose what ran as claude, as `timeout` and as the stderr filter's
# `grep`. Verified. Dropped rather than refused: a caller with `.` in PATH is
# common and harmless everywhere except here. Entries INSIDE --dir are dropped
# too, in cmd_run, once --dir is known.
#   dg_clean_path <path> [root] — prints <path> keeping absolute entries only,
#   and none that resolves to <root> or below it.
dg_clean_path() {
  local in="$1" root="${2-}" out='' entry real
  local -a parts=()
  IFS=: read -r -a parts <<<"$in"
  for entry in ${parts[@]+"${parts[@]}"}; do
    [[ "$entry" == /* ]] || continue
    if [[ -n "$root" ]]; then
      real="$(readlink -m -- "$entry")" || continue
      [[ "$real" == "$root" || "$real" == "$root"/* ]] && continue
    fi
    out="${out:+$out:}$entry"
  done
  printf '%s\n' "${out:-/usr/bin:/bin}"
}
# The caller's PATH is kept aside and NOT used by this script until cmd_run
# has removed every entry inside --dir. Until then everything this script runs
# by name resolves against a fixed root-owned PATH: an absolute entry pointing
# into the tree under review used to supply `dirname` and `readlink` to the
# lines right below, which ran with the caller's whole environment before any
# repository-aware filter existed. Verified with a planted `dirname`.
_DG_CALLER_PATH="$(dg_clean_path "$PATH")"
PATH=/usr/bin:/bin
export PATH

# Resolve the real script location so the `dlg` symlink finds lib/ too.
DG_BIN="${BASH_SOURCE[0]}"
while [[ -L "$DG_BIN" ]]; do
  DG_LINK="$(readlink "$DG_BIN")"
  [[ "$DG_LINK" == /* ]] && DG_BIN="$DG_LINK" || DG_BIN="$(dirname "$DG_BIN")/$DG_LINK"
done
DG_ROOT="$(cd "$(dirname "$DG_BIN")/.." && pwd)"

PROVIDERS_DIR="${DELEGATE_PROVIDERS_DIR:-$DG_ROOT/providers.d}"

# shellcheck source=../lib/config.sh
source "$DG_ROOT/lib/config.sh"
# shellcheck source=../lib/accounts.sh
source "$DG_ROOT/lib/accounts.sh"
# shellcheck source=../lib/permissions.sh
source "$DG_ROOT/lib/permissions.sh"
# shellcheck source=../lib/mcp.sh
source "$DG_ROOT/lib/mcp.sh"

if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
  B=$'\033[1m'; D=$'\033[2m'; R=$'\033[0m'
  GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RED=$'\033[31m'; CYAN=$'\033[36m'
else
  B=''; D=''; R=''; GREEN=''; YELLOW=''; RED=''; CYAN=''
fi

die()  { printf '%s✗%s %s\n' "$RED" "$R" "$*" >&2; exit 1; }

# Joins stdin lines with ", ". Not `paste -sd', '`: paste CYCLES through the
# delimiter list rather than repeating it, so two items join with a bare comma
# and three alternate ", " and ",".
join_lines() { paste -sd, - | sed 's/,/, /g'; }
warn() { printf '%s!%s %s\n' "$YELLOW" "$R" "$*" >&2; }
ok()   { printf '%s✓%s %s\n' "$GREEN" "$R" "$*" >&2; }

usage() {
  cat >&2 <<EOF
${B}delegate${R} — manda trabajo de código acotado a un modelo más barato ${D}(alias: dlg)${R}

${B}USO${R}
  ${CYAN}delegate${R} <proveedor> [opciones] "tarea"      agente con herramientas
  ${CYAN}delegate${R} <proveedor> chat [opciones] "texto"  una pregunta, sin herramientas
  ${CYAN}delegate account${R} <proveedor> <acción>         cuentas (API keys)
  ${CYAN}delegate mcp list${R}                              servidores MCP declarados
  ${CYAN}delegate providers${R}                            proveedores configurados
  ${CYAN}delegate help${R}                                 esta ayuda

${B}ACCESO${R} ${D}(el más angosto que alcance para la tarea)${R}
  ${D}(sin flag)${R}      solo lectura: Read y shell de lectura
  ${CYAN}--edit${R}          agrega escritura de archivos
  ${CYAN}--bash${R}          agrega shell sin restricción
  ${CYAN}--mcp${R} <srv>     agrega las herramientas de LECTURA de ese servidor MCP
  ${CYAN}--mcp-write${R} <s> agrega también las de escritura
                  ${D}Repetibles. Sin ellos, la corrida no alcanza ningún MCP.${R}

${B}OPCIONES${R}
  ${CYAN}--account${R} <n>   usa la key de esa cuenta, sin tocar la activa
  ${CYAN}--dir${R} <ruta>    directorio de trabajo ${D}(default: el actual)${R}
  ${CYAN}--model${R} <id>    pisa el modelo del proveedor
  ${CYAN}--timeout${R} <s>   segundos ${D}(default: el del proveedor)${R}
  ${CYAN}--json${R}          salida JSON: resultado, costo, sesión
  ${CYAN}--sandbox${R} <m>   ${D}bwrap${R}: el hijo corre en bubblewrap ${D}(default: off; lo usa delegate-run)${R}
  ${CYAN}--sandbox-ro${R} <r> ruta visible en solo lectura dentro del sandbox ${D}(repetible)${R}

${B}CUENTAS${R}
  delegate account <proveedor> list
  delegate account <proveedor> add <cuenta>      ${D}pide la key sin eco${R}
  delegate account <proveedor> use <cuenta>      ${D}cambia la activa (global)${R}
  delegate account <proveedor> rm <cuenta>
  delegate account <proveedor> default [cuenta]  ${D}default por invocación${R}

  La cuenta activa es global: otra sesión puede cambiarla a mitad de tu corrida.
  Un pipeline que dependa de una cuenta específica pasa ${CYAN}--account${R}.

${B}QUÉ NO DELEGAR${R}
  Secrets, PII de clientes, datos o consultas de producción, y decisiones de
  dinero, seguridad o compliance. Lo que sale hacia el proveedor es el prompt y
  todo archivo que el agente lea en el directorio de trabajo.
EOF
}

# ─── configuración del proveedor ─────────────────────────────────────────────

declare -A CFG=()

load_provider() {
  # Two statements on purpose: in a single `local`, every word is expanded before
  # any of them is assigned, so `file="$PROVIDERS_DIR/$id"` would read an `id`
  # that does not exist yet — fatal under `set -u`.
  local id="$1" parsed k v
  local file="$PROVIDERS_DIR/$id"
  if [[ ! -f "$file" ]]; then
    local known
    known="$(dg_config_providers "$PROVIDERS_DIR" | join_lines)"
    die "proveedor desconocido: ${B}${id}${R}. Configurados: ${known:-ninguno}"
  fi
  parsed="$(dg_config_parse "$file" "$id")" || exit 2
  while IFS=$'\t' read -r k v; do
    [[ -n "$k" ]] && CFG["$k"]="$v"
  done <<< "$parsed"
  # Defaults. The parser deliberately omits unset keys instead of inventing
  # them, so this is the one place a default exists.
  CFG[key_pattern]="${CFG[key_pattern]:-api_key.%s}"
  CFG[timeout]="${CFG[timeout]:-1800}"
  CFG[caps]="${CFG[caps]:-$(dg_perm_caps_default)}"
  CFG[small_model]="${CFG[small_model]:-${CFG[model]}}"
}

# ─── cuentas ─────────────────────────────────────────────────────────────────

# Resolution order, most explicit first. A concrete account always beats the
# global active symlink, which another session can change under us.
resolve_account_path() {
  local requested="$1" name
  if [[ -n "$requested" ]]; then
    name="$requested"
  elif [[ -n "${DELEGATE_ACCOUNT:-}" ]]; then
    name="$DELEGATE_ACCOUNT"
  elif name="$(dg_account_default_get "${CFG[key_dir]}" 2>/dev/null)" && [[ -n "$name" ]]; then
    :
  elif [[ -n "${CFG[default_account]:-}" ]]; then
    name="${CFG[default_account]}"
  elif name="$(dg_account_active "${CFG[key_dir]}" "${CFG[key_pattern]}" 2>/dev/null)" && [[ -n "$name" ]]; then
    :
  else
    local avail
    avail="$(dg_account_list "${CFG[key_dir]}" "${CFG[key_pattern]}" | join_lines)"
    if [[ -n "$avail" ]]; then
      die "no hay cuenta activa. Elige una con ${B}delegate account $PROVIDER use <cuenta>${R} o pasa ${B}--account${R}. Configuradas: $avail"
    fi
    die "no hay ninguna key configurada para ${B}${PROVIDER}${R}. Agrega una: ${B}delegate account $PROVIDER add <cuenta>${R}"
  fi
  dg_account_path "${CFG[key_dir]}" "${CFG[key_pattern]}" "$name" || exit 2
}

cmd_account() {
  local provider="${1:-}" action="${2:-list}" name="${3:-}"
  [[ -n "$provider" ]] || die "falta el proveedor. Uso: delegate account <proveedor> <acción>"
  load_provider "$provider"
  local kd="${CFG[key_dir]}" kp="${CFG[key_pattern]}"

  case "$action" in
    list|ls)
      local active current path fp
      active="$(dg_account_active "$kd" "$kp" 2>/dev/null || true)"
      current="$(dg_account_default_get "$kd" 2>/dev/null || true)"
      local found=0
      while read -r n; do
        [[ -n "$n" ]] || continue
        found=1
        path="$(dg_account_path "$kd" "$kp" "$n")"
        fp="$(dg_account_fingerprint "$path" 2>/dev/null || echo '????????')"
        local marks=''
        [[ "$n" == "$active" ]] && marks+=" ${GREEN}activa${R}"
        [[ "$n" == "$current" ]] && marks+=" ${CYAN}default${R}"
        printf '  %s%-16s%s %s%s%s%s\n' "$B" "$n" "$R" "$D" "$fp" "$R" "$marks"
      done < <(dg_account_list "$kd" "$kp")
      if (( ! found )); then
        warn "no hay cuentas configuradas para $provider"
        printf '    %sagrega una:%s delegate account %s add <cuenta>\n' "$D" "$R" "$provider" >&2
        return 1
      fi
      ;;
    add)
      [[ -n "$name" ]] || die "falta el nombre. Uso: delegate account $provider add <cuenta>"
      dg_account_add "$kd" "$kp" "$name"
      local path; path="$(dg_account_path "$kd" "$kp" "$name")"
      ok "guardada como ${B}${name}${R} ${D}(huella $(dg_account_fingerprint "$path"), permisos 600)${R}"
      # First key configured becomes active: there is nothing to disambiguate.
      if ! dg_account_active "$kd" "$kp" >/dev/null 2>&1; then
        dg_account_activate "$kd" "$path"
        ok "quedó activa por ser la primera"
      else
        printf '    %sactívala:%s delegate account %s use %s\n' "$D" "$R" "$provider" "$name" >&2
      fi
      ;;
    use)
      [[ -n "$name" ]] || die "falta el nombre. Uso: delegate account $provider use <cuenta>"
      local path; path="$(dg_account_path "$kd" "$kp" "$name")" || exit 2
      # stdout discarded: validate prints the RESOLVED path, and `use` has to
      # point `api_key` at the account file by its own name, not at whatever
      # that file happens to resolve to.
      dg_account_validate "$kd" "$path" >/dev/null || die "no puedo usar la cuenta '$name'"
      dg_account_activate "$kd" "$path"
      ok "cuenta activa: ${B}${name}${R}"
      ;;
    rm|remove)
      [[ -n "$name" ]] || die "falta el nombre. Uso: delegate account $provider rm <cuenta>"
      local path; path="$(dg_account_path "$kd" "$kp" "$name")" || exit 2
      [[ -e "$path" ]] || die "no existe la cuenta '$name'"
      printf '%sBorrar la key de%s %s%s%s. Escribe el nombre para confirmar: ' \
        "$YELLOW" "$R" "$B" "$name" "$R" >&2
      local confirm; read -r confirm
      [[ "$confirm" == "$name" ]] || die "no coincide, no borré nada"
      local rc=0
      dg_account_remove "$kd" "$kp" "$name" || rc=$?
      if (( rc == 10 )); then
        ok "borrada la cuenta ${B}${name}${R}"
        local resto; resto="$(dg_account_list "$kd" "$kp" | join_lines)"
        if [[ -n "$resto" ]]; then
          warn "era la activa: no hay ninguna activa, y las corridas sin --account van a fallar hasta que elijas otra"
          printf '    %sdisponibles:%s %s\n' "$D" "$R" "$resto" >&2
        else
          # `|| true` no alcanzaba: esto era el ÚLTIMO comando de la función en
          # el camino de éxito, así que un `[[ -n "$resto" ]] &&` que fallara se
          # propagaba como return 1 y `set -e` mataba el script después de haber
          # borrado la key. El exit code mentía sobre una operación que salió
          # bien.
          warn "era la activa y no queda ninguna: agrega otra con ${B}delegate account ${provider} add <cuenta>${R}"
        fi
      elif (( rc != 0 )); then
        exit "$rc"
      else
        ok "borrada la cuenta ${B}${name}${R}"
      fi
      ;;
    default)
      if [[ -z "$name" ]]; then
        dg_account_default_get "$kd" || die "no hay cuenta default para $provider"
      else
        local path; path="$(dg_account_path "$kd" "$kp" "$name")" || exit 2
        dg_account_validate "$kd" "$path" >/dev/null || die "no puedo usar la cuenta '$name'"
        dg_account_default_set "$kd" "$name"
        ok "cuenta default de ${B}${provider}${R}: ${B}${name}${R}"
      fi
      ;;
    *)
      die "acción desconocida: $action ${D}(list | add | use | rm | default)${R}"
      ;;
  esac
}

cmd_providers() {
  local id parsed k v
  local found=0
  while read -r id; do
    [[ -n "$id" ]] || continue
    found=1
    declare -A P=()
    if parsed="$(dg_config_parse "$PROVIDERS_DIR/$id" "$id" 2>/dev/null)"; then
      while IFS=$'\t' read -r k v; do [[ -n "$k" ]] && P["$k"]="$v"; done <<< "$parsed"
      printf '  %s%-10s%s %s%s%s\n' "$B" "$id" "$R" "$D" "${P[model]:-?}" "$R"
      printf '      %scaps:%s %s\n' "$D" "$R" "${P[caps]:-$(dg_perm_caps_default)}"
      [[ -n "${P[residency]:-}" ]] && printf '      %sdatos:%s %s\n' "$D" "$R" "${P[residency]}"
    else
      printf '  %s%-10s%s %sconfig inválida%s\n' "$B" "$id" "$R" "$RED" "$R"
    fi
    unset P
  done < <(dg_config_providers "$PROVIDERS_DIR")
  (( found )) || { warn "no hay proveedores en $PROVIDERS_DIR"; return 1; }
}

cmd_mcp() {
  # Read-only: this lists what the machine owner declared, and listing is the
  # only thing it does. Nothing here enables a server — that happens per
  # invocation, with --mcp, and only for a server named by hand.
  local sub="${1:-list}"
  [[ "$sub" == 'list' ]] || die "uso: delegate mcp list"

  local dir id parsed k v found=0
  dir="$(dg_mcp_dir)"
  if [[ ! -d "$dir" ]]; then
    warn "no hay directorio de servidores MCP en $dir"
    printf '  %sun archivo por servidor, formato clave<TAB>valor; hay ejemplos en examples/mcp.d/%s\n' "$D" "$R"
    return 1
  fi

  while read -r id; do
    [[ -n "$id" ]] || continue
    found=1
    declare -A M=()
    if parsed="$(dg_mcp_parse "$dir/$id" "$id" 2>/dev/null)"; then
      while IFS=$'\t' read -r k v; do [[ -n "$k" ]] && M["$k"]="$v"; done <<< "$parsed"
      printf '  %s%-12s%s %s%s%s\n' "$B" "$id" "$R" "$D" "${M[transport]:-?}" "$R"
      [[ -n "${M[description]:-}" ]] && printf '      %s%s%s\n' "$D" "${M[description]}" "$R"
      # Counts, not the lists: the point of this view is which servers exist and
      # whether writing is even on offer, not to reproduce an allowlist that
      # only matters at resolve time.
      printf '      %slectura:%s %s' "$D" "$R" "$(printf '%s' "${M[tools_read]:-}" | tr ',' '\n' | grep -c .)"
      if [[ -n "${M[tools_write]:-}" ]]; then
        printf '   %sescritura:%s %s %s(--mcp-write)%s' "$D" "$R" \
          "$(printf '%s' "${M[tools_write]}" | tr ',' '\n' | grep -c .)" "$D" "$R"
      fi
      printf '\n'
      [[ -n "${M[env_passthrough]:-}" ]] &&
        printf '      %sreenvía del shell:%s %s\n' "$D" "$R" "${M[env_passthrough]}"
      # `rules` in full, not a count. It is the one value in an entry that
      # changes what the delegated model is TOLD, and it is appended after the
      # run's own rules, which is the strongest position in the prompt. An
      # entry that says "ignora las reglas anteriores" is a legitimate thing to
      # write in this format and an illegitimate thing to keep out of sight, so
      # the only defence is that whoever runs `mcp list` can read it.
      [[ -n "${M[requires_file]:-}" ]] &&
        printf '      %snecesita:%s %s\n' "$D" "$R" "${M[requires_file]}"
      [[ -n "${M[rules]:-}" ]] &&
        printf '      %sle dice al modelo:%s %s\n' "$D" "$R" "${M[rules]}"
    else
      # The reason went to /dev/null on purpose: a listing that prints one
      # entry's parse error in the middle of the others is unreadable. The
      # pointer is enough, and `--mcp <id>` prints the real reason.
      printf '  %s%-12s%s %sentrada inválida%s %s(delegate <proveedor> --mcp %s dice por qué)%s\n' \
        "$B" "$id" "$R" "$RED" "$R" "$D" "$id" "$R"
    fi
    unset M
  done < <(dg_mcp_servers "$dir")

  # dg_mcp_servers drops a file whose NAME is not a valid id, which is right —
  # nobody could ask for it with --mcp anyway. But dropping it silently from
  # this listing is how someone stares at a file they wrote and wonders why it
  # does nothing. Named, not ignored.
  local path base bad=()
  for path in "$dir"/*; do
    [[ -f "$path" ]] || continue
    base="${path##*/}"
    dg_mcp_servers "$dir" | grep -qxF -- "$base" || bad+=("$base")
  done
  if (( ${#bad[@]} )); then
    warn "ignorados por tener un nombre que no es un id válido (^[a-z][a-z0-9-]{0,31}$): $(printf '%s\n' "${bad[@]}" | join_lines)"
  fi

  (( found )) || { warn "no hay servidores MCP declarados en $dir"; return 1; }
}

# ─── sandbox (bubblewrap) ────────────────────────────────────────────────────
#
# `--sandbox bwrap` runs the child (timeout's command: the harness and
# everything it spawns) inside bubblewrap. The CLI itself stays OUTSIDE: it
# reads the key from its 600 file before the sandbox exists, and the key only
# crosses into it in the child's environment, as it always did. The key_dir,
# the rest of the user's home, ~/.ssh and every other repository are simply not
# mounted. See CLAUDE.md, "Sandbox".

# Refusals of the sandbox flags exit 2, like every other refusal that happens
# before the key is read: a run asked to be confined never runs unconfined.
dg_reject() { printf '%s✗%s %s\n' "$RED" "$R" "$*" >&2; exit 2; }

# One classic-BPF instruction (struct sock_filter, little-endian): code, jt,
# jf, k. Bash's printf builtin emits the \x00 bytes as they are.
_dg_bpf_ins() {
  local c=$1 t=$2 f=$3 k=$4 fmt
  printf -v fmt '\\x%02x\\x%02x\\x%02x\\x%02x\\x%02x\\x%02x\\x%02x\\x%02x' \
    $(( c & 255 )) $(( c >> 8 & 255 )) "$t" "$f" \
    $(( k & 255 )) $(( k >> 8 & 255 )) $(( k >> 16 & 255 )) $(( k >> 24 & 255 ))
  printf "$fmt"
}

# The seccomp filter bwrap installs on the sandboxed command, for $1 (x86_64
# or aarch64). The network namespace is SHARED (the harness needs the
# provider's API), and the abstract unix-socket namespace belongs to the
# network namespace: without this, the sandbox reached @/tmp/.X11-unix/X0,
# and an X server that admits the user by uid (SI:localuser) accepted it —
# keystrokes into a terminal outside. Verified with xdpyinfo. So:
#   - socket(AF_UNIX, ...) fails with EAFNOSUPPORT: no unix socket can be
#     created, so none can connect to an abstract (or any) address;
#   - socketpair() only for SOCK_STREAM and SOCK_SEQPACKET (libuv's stdio
#     pipes): a datagram pair can be re-connect()ed to another address;
#   - io_uring_setup fails with ENOSYS: IORING_OP_SOCKET would create a
#     socket without the socket() syscall that this filter sees;
#   - x32 syscall numbers fail with ENOSYS, and any foreign architecture
#     (int 0x80 on x86_64) kills the process.
dg_seccomp_bpf() {
  local arch nr_socket nr_pair nr_uring=425
  case "$1" in
    x86_64)  arch=$(( 0xC000003E )); nr_socket=41;  nr_pair=53 ;;
    aarch64) arch=$(( 0xC00000B7 )); nr_socket=198; nr_pair=199 ;;
    *) return 1 ;;
  esac
  local ld=$(( 0x20 )) jeq=$(( 0x15 )) jge=$(( 0x35 )) and=$(( 0x54 )) ret=$(( 0x06 ))
  local allow=$(( 0x7fff0000 )) kill=$(( 0x80000000 ))
  local eafnosupport=$(( 0x00050000 | 97 )) enosys=$(( 0x00050000 | 38 ))
  _dg_bpf_ins $ld  0 0 4                    #  0 A = arch
  _dg_bpf_ins $jeq 1 0 $arch                #  1 native? -> 3
  _dg_bpf_ins $ret 0 0 $kill                #  2
  _dg_bpf_ins $ld  0 0 0                    #  3 A = nr
  _dg_bpf_ins $jge 13 0 $(( 0x40000000 ))   #  4 x32 -> 18
  _dg_bpf_ins $jeq 3 0 $nr_socket           #  5 socket -> 9
  _dg_bpf_ins $jeq 5 0 $nr_pair             #  6 socketpair -> 12
  _dg_bpf_ins $jeq 10 0 $nr_uring           #  7 io_uring_setup -> 18
  _dg_bpf_ins $ret 0 0 $allow               #  8
  _dg_bpf_ins $ld  0 0 16                   #  9 A = low word of args[0] (domain)
  _dg_bpf_ins $jeq 5 0 1                    # 10 AF_UNIX -> 16
  _dg_bpf_ins $ret 0 0 $allow               # 11
  _dg_bpf_ins $ld  0 0 24                   # 12 A = low word of args[1] (type)
  _dg_bpf_ins $and 0 0 15                   # 13 drop SOCK_CLOEXEC / SOCK_NONBLOCK
  _dg_bpf_ins $jeq 2 0 1                    # 14 SOCK_STREAM -> 17
  _dg_bpf_ins $jeq 1 0 5                    # 15 SOCK_SEQPACKET -> 17
  _dg_bpf_ins $ret 0 0 $eafnosupport        # 16
  _dg_bpf_ins $ret 0 0 $allow               # 17
  _dg_bpf_ins $ret 0 0 $enosys              # 18
}

# Fills _DG_X_SBX with the bwrap prefix for the child. Arguments: bwrap path,
# the resolved working directory, the stub directory, the resolved claude
# binary, the seccomp fd, then the read-only paths. The order of the mounts is
# the policy: system directories read-only, a private tmpfs for /tmp and HOME
# (so nothing of the real home is there, only what is bound on top of it), the
# harness binary and the stubs read-only, the working directory read-write,
# and LAST the read-only paths, so a gitdir inside the tree stays read-only.
dg_sandbox_argv() {
  local bwrap="$1" wroot="$2" stubs="$3" claude_real="$4" sfd="$5"; shift 5
  local d target p
  _DG_X_SBX=("$bwrap"
    --unshare-all --share-net --unshare-user --disable-userns
    --die-with-parent --new-session
    --ro-bind /usr /usr)
  for d in /bin /sbin /lib /lib32 /lib64 /libx32; do
    if [[ -L "$d" ]]; then
      _DG_X_SBX+=(--symlink "$(readlink -- "$d")" "$d")
    elif [[ -d "$d" ]]; then
      _DG_X_SBX+=(--ro-bind "$d" "$d")
    fi
  done
  _DG_X_SBX+=(--ro-bind /etc /etc --proc /proc --dev /dev --tmpfs /tmp)
  # /etc/resolv.conf is usually a symlink into /run (systemd-resolved): the
  # one file it names, never its directory (which holds resolved's varlink
  # socket, unreachable anyway without AF_UNIX).
  target="$(readlink -f -- /etc/resolv.conf 2>/dev/null)" || target=''
  if [[ "$target" == /run/* && -f "$target" ]]; then
    _DG_X_SBX+=(--ro-bind "$target" "$target")
  fi
  if [[ "${HOME:-}" == /?* ]]; then
    _DG_X_SBX+=(--perms 0700 --tmpfs "$HOME")
  fi
  # The harness: a native (ELF) binary is mounted alone; a script (an npm
  # install's cli.js) needs its package directory. Never a directory that is
  # HOME or holds it: a `claude` sitting in ~/bin or ~ would mount all of it.
  local magic=''
  LC_ALL=C read -r -N 4 magic < "$claude_real" 2>/dev/null || true
  if [[ "$magic" == $'\x7fELF' ]]; then
    d="$claude_real"
  else
    d="$(dirname -- "$claude_real")"
    if [[ "${HOME:-}" == /?* && "$(readlink -f -- "$HOME" 2>/dev/null || printf '%s' "$HOME")/" == "$d"/* ]] ||
       [[ "$d" == / ]]; then
      die "--sandbox bwrap: claude ($claude_real) no es un binario y su directorio contiene tu HOME; no lo monto en el sandbox"
    fi
  fi
  _DG_X_SBX+=(--ro-bind "$d" "$d" --ro-bind "$stubs" "$stubs" --bind "$wroot" "$wroot")
  for p in "$@"; do
    _DG_X_SBX+=(--ro-bind "$p" "$p")
  done
  _DG_X_SBX+=(--setenv TMPDIR /tmp --seccomp "$sfd" --chdir "$wroot" --)
}

# ─── corrida delegada ────────────────────────────────────────────────────────

cmd_run() {
  local mode='agent'
  if [[ "${1:-}" == 'chat' ]]; then mode='chat'; shift; fi

  local want_edit=0 want_bash=0 account='' workdir="$PWD"
  local format='text' timeout_s='' model=''
  # Repeatable, so they accumulate as comma-separated lists for lib/mcp.sh.
  local mcp_read='' mcp_write=''
  local sandbox='off'
  local -a sandbox_ro=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --edit)        want_edit=1; shift ;;
      --bash)        want_bash=1; shift ;;
      --mcp)         mcp_read="${mcp_read:+$mcp_read,}${2:?--mcp necesita un servidor}"; shift 2 ;;
      --mcp-write)   mcp_write="${mcp_write:+$mcp_write,}${2:?--mcp-write necesita un servidor}"; shift 2 ;;
      --json)        format='json'; shift ;;
      --account)     account="${2:?--account necesita un nombre}"; shift 2 ;;
      --dir)         workdir="${2:?--dir necesita una ruta}"; shift 2 ;;
      --model)       model="${2:?--model necesita un id}"; shift 2 ;;
      --timeout)     timeout_s="${2:?--timeout necesita segundos}"; shift 2 ;;
      --sandbox)     sandbox="${2:?--sandbox necesita bwrap u off}"; shift 2 ;;
      --sandbox-ro)  sandbox_ro+=("${2:?--sandbox-ro necesita una ruta}"); shift 2 ;;
      --)            shift; break ;;
      -*)            die "opción desconocida: $1" ;;
      *)             break ;;
    esac
  done

  [[ $# -gt 0 ]] || die "falta la tarea. Uso: delegate $PROVIDER [opciones] \"tarea\""

  # DEEPSEEK_ACCOUNT was documented as choosing the account and was ignored, so
  # a caller following the docs was billed to the default or the active one
  # without a word. Refused, not honoured as an alias: silently changing which
  # key pays is worse than failing, and one name is easier to keep honest.
  # `+x`: defined counts, even empty; a stale `export DEEPSEEK_ACCOUNT=` passed.
  if [[ -n "${DEEPSEEK_ACCOUNT+x}" ]]; then
    printf '%s✗%s %s\n' "$RED" "$R" \
      "DEEPSEEK_ACCOUNT ya no elige la cuenta: usa ${B}DELEGATE_ACCOUNT${R} o ${B}--account${R}, y quita DEEPSEEK_ACCOUNT del entorno" >&2
    exit 2
  fi
  local prompt="$*"

  [[ -d "$workdir" ]] || die "no existe el directorio: $workdir"
  # No PATH entry inside the tree under review, for this script and for the
  # child: an absolute entry pointing into --dir is `.` spelled differently.
  local wroot
  wroot="$(readlink -f -- "$workdir")" || die "no puedo resolver el directorio de trabajo $workdir"
  PATH="$(dg_clean_path "$_DG_CALLER_PATH" "$wroot")"

  if [[ "$mode" == 'chat' ]]; then
    # chat is a mode, not a lesser agent: no tools at all, so a permission flag
    # asked for here was a misunderstanding worth surfacing, not something to
    # quietly ignore.
    (( want_edit || want_bash )) && die "chat no tiene herramientas: quita --edit y --bash, o usa el modo agente"
    [[ -n "$mcp_read$mcp_write" ]] && die "chat no tiene herramientas: quita --mcp y --mcp-write, o usa el modo agente"
  fi

  [[ -n "$timeout_s" ]] || timeout_s="${CFG[timeout]}"
  [[ "$timeout_s" =~ ^[0-9]+$ && "$timeout_s" -ge 1 ]] || die "--timeout debe ser un entero de segundos"
  [[ -n "$model" ]] || model="${CFG[model]}"

  # ── sandbox: validated here, before the key is read ──
  local bwrap_bin='' sbx_ro_real=() sp
  case "$sandbox" in
    off)
      (( ${#sandbox_ro[@]} )) && dg_reject "--sandbox-ro solo vale con --sandbox bwrap"
      ;;
    bwrap)
      bwrap_bin="$(type -P bwrap)" ||
        dg_reject "--sandbox bwrap: no encuentro bwrap en el PATH (instálalo con 'sudo apt install bubblewrap')"
      [[ "$bwrap_bin" == /* ]] || dg_reject "--sandbox bwrap: bwrap tiene que resolverse a una ruta absoluta"
      case "$HOSTTYPE" in
        x86_64|aarch64) ;;
        *) dg_reject "--sandbox bwrap: no hay filtro seccomp para la arquitectura $HOSTTYPE" ;;
      esac
      # A working directory that is / or contains HOME would bind the whole
      # home back in, read-write, over the private tmpfs.
      if [[ "$wroot" == / ]] ||
         { [[ "${HOME:-}" == /?* ]] && [[ "$(readlink -f -- "$HOME" 2>/dev/null || printf '%s' "$HOME")/" == "$wroot"/* ]]; }; then
        dg_reject "--sandbox bwrap: el directorio de trabajo no puede ser / ni contener tu HOME ($wroot)"
      fi
      for sp in ${sandbox_ro[@]+"${sandbox_ro[@]}"}; do
        [[ "$sp" == /* && -e "$sp" ]] || dg_reject "--sandbox-ro necesita una ruta absoluta que exista: $sp"
        sbx_ro_real+=("$(readlink -f -- "$sp")") || dg_reject "no puedo resolver $sp"
      done
      ;;
    *) dg_reject "--sandbox acepta bwrap u off, no '$sandbox'" ;;
  esac

  # Permissions before the key: a run that is going to be refused must be
  # refused before anything reads a secret from disk.
  DG_MCP_JSON=''
  DG_MCP_TOOLS=''
  DG_MCP_RULES=''
  DG_MCP_ENV=()
  DG_MCP_NEED=()
  if [[ "$mode" == 'agent' ]]; then
    # Which servers exist is the machine owner's declaration; which ones this run
    # reaches is the invocation's. Resolving the entries first means an unknown
    # server name is refused before the ceiling is even consulted, and long
    # before any key is read.
    local want_mcp=0 want_mcp_write=0
    if [[ -n "$mcp_read$mcp_write" ]]; then
      dg_mcp_resolve "$(dg_mcp_dir)" "$mcp_read" "$mcp_write" || exit 2
      want_mcp=1
      [[ -n "$mcp_write" ]] && want_mcp_write=1
      # Two families are refused outright.
      #
      # ANTHROPIC_* and CLAUDE_CODE_* are what this run itself defines. The
      # exports that pin the endpoint, the model and the key are applied after
      # the passthrough, so today an entry naming one of them would be
      # overwritten rather than win — but the refusal is not about ordering: a
      # server asking for a name the run owns is asking for something it cannot
      # have, and quietly handing it a different value would be its own
      # surprise.
      #
      # The second family is the one that matters more now that the child's
      # environment is built from an allowlist: the passthrough is the ONLY
      # channel through which anything from this shell crosses. A name whose
      # value the harness treats as CODE turns that channel into code execution
      # inside the delegated process — NODE_OPTIONS=--require=... loads a file
      # of the entry author's choosing, LD_PRELOAD the same for any binary the
      # run spawns, GIT_EXTERNAL_DIFF and GIT_SSH_COMMAND are commands, and
      # BASH_ENV is sourced by every non-interactive bash. No MCP server needs
      # any of them forwarded. Credentials are NOT on this list on purpose:
      # forwarding a token is what the feature is for, so the answer there is
      # visibility, not refusal — see the line printed below.
      local rn
      for rn in ${DG_MCP_ENV[@]+"${DG_MCP_ENV[@]}"}; do
        case "$rn" in
          ANTHROPIC_*|CLAUDE_CODE_*)
            printf '%s✗%s %s\n' "$RED" "$R" \
              "un servidor MCP pidió reenviar ${B}${rn}${R}, que esta corrida define; quita ese nombre de env_passthrough" >&2
            exit 2 ;;
          # GIT_* whole, not one name at a time. GIT_CONFIG_COUNT with
          # GIT_CONFIG_KEY_0/GIT_CONFIG_VALUE_0 passed when only GIT_SSH_COMMAND
          # and friends were listed, and forwarded `diff.external=<program>`
          # into the child, where the floor's `git diff` ran it. Git reads
          # dozens of these names, several as config or as commands; a list
          # would have to keep up with git. The allowlist of safe GIT_* names
          # is empty until one is actually needed.
          #
          # The proxy and TLS names are here for the same reason with a different
          # payload: the child's HTTPS traffic carries the provider key, and a
          # forwarded proxy (with an extra CA, or verification off) is a
          # man-in-the-middle on it. GCONV_PATH makes glibc's iconv load a
          # shared object from a directory of the value's choosing.
          LD_*|GIT_*|NODE_OPTIONS|NODE_REPL_EXTERNAL_MODULE|NODE_TLS_REJECT_UNAUTHORIZED|NODE_EXTRA_CA_CERTS|HTTPS_PROXY|HTTP_PROXY|ALL_PROXY|https_proxy|http_proxy|all_proxy|GCONV_PATH|BASH_ENV|ENV|SHELLOPTS|BASHOPTS|IFS|PATH|HOME|PYTHONPATH|PYTHONSTARTUP|PERL5LIB|PERL5OPT|RUBYOPT|PAGER|EDITOR|VISUAL)
            printf '%s✗%s %s\n' "$RED" "$R" \
              "un servidor MCP pidió reenviar ${B}${rn}${R}: su valor se interpreta como código dentro de la corrida delegada, así que no se reenvía nunca" >&2
            exit 2 ;;
        esac
      done

      # Preconditions of the entries that were asked for. An entry whose `rules`
      # say "read X first" is broken in a tree that has no X, and a delegated
      # run told to read a file that is not there does not stop — it improvises,
      # which is the expensive failure. Checked here, before the key is read,
      # like every other refusal.
      #
      # A relative path resolves against the working directory of the run, which
      # is `--dir` and is where the child will look for it too. Resolved with
      # the same containment rule the key files use, so a precondition cannot
      # point outside the tree under review; an absolute path is allowed and is
      # a precondition of the machine, not of the tree.
      local need nid npath nfull nreal nroot
      nroot="$(readlink -f -- "$workdir")" || die "no puedo resolver el directorio de trabajo $workdir"
      for need in ${DG_MCP_NEED[@]+"${DG_MCP_NEED[@]}"}; do
        nid="${need%%$'\t'*}"
        npath="${need#*$'\t'}"
        if [[ "$npath" == /* ]]; then
          nfull="$npath"
        else
          nfull="$nroot/$npath"
        fi
        if [[ ! -e "$nfull" ]]; then
          printf '%s✗%s %s\n' "$RED" "$R" \
            "el servidor MCP ${B}${nid}${R} necesita ${B}${npath}${R}, que no existe en $([[ "$npath" == /* ]] && printf 'esta máquina' || printf '%s' "$nroot")" >&2
          printf '    %sestá declarado en su requires_file; quita --mcp %s o corre desde un árbol que lo tenga%s\n' \
            "$D" "$nid" "$R" >&2
          exit 2
        fi
        # Relative paths only: an absolute one was already a deliberate choice
        # about a path outside the tree.
        if [[ "$npath" != /* ]]; then
          nreal="$(readlink -f -- "$nfull")" || die "no puedo resolver $npath"
          [[ "$nreal" == "$nroot" || "$nreal" == "$nroot"/* ]] ||
            die "el requires_file '$npath' del servidor $nid sale del directorio de trabajo"
        fi
      done
    fi
    dg_perm_resolve "${CFG[caps]}" "$want_edit" "$want_bash" \
      "$want_mcp" "$want_mcp_write" "${DG_MCP_RULES:-}" || exit 2
    # The MCP allowlist is appended here, not inside lib/permissions.sh: that
    # file owns the local tool lattice and must stay ignorant of which servers
    # exist.
    [[ -n "$DG_MCP_TOOLS" ]] && DG_ALLOWED="$DG_ALLOWED,$DG_MCP_TOOLS"
  else
    DG_TOOLS=''
    DG_ALLOWED=''
    DG_RULES='Responde en español venezolano neutro (tú, nunca voseo). No tienes herramientas: no puedes leer archivos ni ejecutar nada. Responde solo con lo que te den en el mensaje. Si te falta información para responder, dilo en vez de suponerla.'
  fi

  # ── la key: se lee UNA sola vez, acá, después de validar todo lo demás ──
  # Entre resolver la cuenta y abrir el archivo hay una carrera: otro proceso
  # puede cambiar el symlink de la activa. Leerla una vez y en este punto acota
  # esa ventana a lo mínimo, y deja la corrida inmune a un cambio posterior.
  # `+x` is not decoration: a `local` that shadows an exported variable of the
  # same name KEEPS the export attribute, so with `export key=...` in the
  # caller's shell the account key silently joined the environment of every
  # helper this script runs afterwards — including the `grep` in the process
  # substitution, which is not the child. Verified on Bash 5.2.
  local +x key_path key
  key_path="$(resolve_account_path "$account")"
  # One descriptor for the checks and the read: validating a name and then
  # reading it again let the file be swapped in between.
  key="$(dg_account_load "${CFG[key_dir]}" "$key_path")" || exit 1
  [[ -n "$key" ]] || die "la key en $key_path está vacía"

  # Other AI CLIs are unreachable from a delegated run. Invoking codex or claude
  # from here spent the scarcest quota on reviews nobody asked for, and a rule in
  # the prompt did not stop it. Stubs first in PATH make those calls fail; claude
  # itself is resolved to an absolute path before PATH changes.
  #
  # claude, timeout and the stderr filter's grep are resolved to absolute paths
  # HERE, before the cd into --dir and before PATH gains the stubs: resolved
  # later, a relative or tree-controlled PATH entry chose them.
  local claude_bin timeout_bin grep_bin env_bin stub_dir tool
  claude_bin="$(type -P claude)" || die "no encuentro el binario de claude en el PATH"
  timeout_bin="$(type -P timeout)" || die "no encuentro timeout en el PATH"
  grep_bin="$(type -P grep)" || die "no encuentro grep en el PATH"
  env_bin="$(type -P env)" || die "no encuentro env en el PATH"
  [[ "$claude_bin" == /* && "$timeout_bin" == /* && "$grep_bin" == /* && "$env_bin" == /* ]] ||
    die "claude, timeout, grep y env tienen que resolverse a rutas absolutas"
  # A private directory per run, created by mktemp (exclusive, mode 700) and
  # removed when the run ends (not on a SIGKILL of the run's process, which
  # nothing can trap; see CLAUDE.md). It used to be one shared directory under
  # XDG_CACHE_HOME, rewritten by every run with `>`: a symlink precreated there
  # was followed and its target overwritten, an extra executable left there
  # (`node`, `git`) ran ahead of the real one in every later run, and two
  # concurrent runs rewrote each other's `git`. Verified. XDG_RUNTIME_DIR first
  # because it is the user's own 700 directory.
  #
  # Mode 700 protects what is INSIDE the directory, not its entry in the parent:
  # whoever can write the parent can rename ours away and put their own, with a
  # `grep` that then runs holding the delegated environment and its key. So the
  # parent must be owned by this user or by root, and either writable by its
  # owner alone or sticky (as /tmp is, where nobody renames another's entry).
  # Group-writable used to be accepted, and a shared group is enough for that.
  local stub_parent="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}" pmode powner
  [[ "$stub_parent" == /* && -d "$stub_parent" ]] || stub_parent=/tmp
  read -r pmode powner < <(stat -L -c '%a %u' -- "$stub_parent") ||
    die "no puedo leer los permisos de $stub_parent"
  if [[ "$powner" != "$EUID" && "$powner" != 0 ]] ||
     (( (8#$pmode & 8#0022) && !(8#$pmode & 8#1000) )); then
    die "el directorio temporal $stub_parent no es tuyo o lo pueden escribir otros (grupo o todos) sin sticky bit; revisa XDG_RUNTIME_DIR y TMPDIR"
  fi
  stub_dir="$(mktemp -d -p "$stub_parent" delegate-stubs.XXXXXXXX)" ||
    die "no pude crear el directorio de stubs en $stub_parent"
  _DG_X_STUBS="$stub_dir"
  # Absolute: the cleanup runs after the environment wipe, when PATH is gone.
  _DG_X_RM="$(type -P rm)" || die "no encuentro rm en el PATH"
  trap 'dg_cleanup_stubs' EXIT
  # Name interception, not a sandbox: a run with --bash can still call a binary
  # by its absolute path or rewrite PATH. Invariant 5 says exactly that.
  for tool in codex claude delegate dlg dg deepseek-agent qwen-agent opencode gemini; do
    printf '#!/bin/sh\necho "delegate: %s está bloqueado en tareas delegadas" >&2\nexit 126\n' \
      "$tool" > "$stub_dir/$tool"
    chmod +x "$stub_dir/$tool"
  done

  # git on the read-only floor. `git diff`, `log`, `show`, `status` and `blame`
  # are allowed there, and every one of them runs programs that configuration
  # names: diff.external and a diff driver's command, a textconv driver,
  # core.fsmonitor, core.pager, a clean filter. Anyone who can write the
  # repository's .git/config — a hostile tree, or this very run with --edit —
  # turned "read-only" into code execution. Verified: each helper ran from a
  # plain `git diff`/`status`/`blame` before this.
  #
  # The allowlist only lets `git <subcommand>` through by name, so a `git`
  # first in PATH is what the model's command reaches. It ignores system and
  # global config, overrides the executable keys of the repository's (filters,
  # diff drivers and signature programs included), puts --no-ext-diff,
  # --no-textconv and --ignore-submodules=all right after the subcommand, and
  # refuses every abbreviation of the options that undo them and every prefix
  # of --output. Defence in depth, not a boundary: it lists the helpers git
  # 2.43 is known to run, a newer git may add one, and the real limit stays
  # "never delegate over a hostile tree" (CLAUDE.md). Floor only: --bash is
  # unrestricted shell, and constraining git there would be a narrower grant
  # than the one asked for.
  local real_git=''
  real_git="$(type -P git 2>/dev/null)" || true
  if [[ "$mode" == 'agent' ]] && (( ! want_bash )) && [[ "$real_git" == /* ]]; then
    # Quoted heredoc: nothing in it is expanded here. Only the path of the real
    # git is substituted, single-quoted for sh.
    local wrapper
    wrapper="$(cat <<'WRAP'
#!/bin/sh
# Written by delegate for the read-only floor. See bin/delegate.
#
# The hardening options go RIGHT AFTER the subcommand, before anything the
# caller wrote. Appended at the end they were swallowed as the value of an
# option that takes one: `git diff --line-prefix` (or --src-prefix,
# --dst-prefix, --word-diff-regex...) consumed `--no-ext-diff`, and the
# repository's diff driver ran. First, they are only defeated by a later
# option that turns them back on, so every spelling and every abbreviation of
# those is refused: --ext*, --textc*, --ignore-su*, --sub* (`git diff
# --no-index` takes any unique prefix of a long option). --output is refused
# in every prefix (it would write a file).
for a in "$@"; do
  case "$a" in
    --ext*|--textc*|--ignore-su*|--sub*|--o|--o=*|--ou|--ou=*|--out|--out=*|--outp|--outp=*|--outpu|--outpu=*|--output|--output=*)
      echo "delegate: git $a está denegado en el piso de solo lectura" >&2; exit 126 ;;
  esac
done
GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null; export GIT_CONFIG_NOSYSTEM GIT_CONFIG_GLOBAL
unset GIT_CONFIG GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS GIT_EXTERNAL_DIFF GIT_PAGER PAGER GIT_ATTR_SOURCE
# Submodules: their content is read by a git running with the SUBMODULE's
# config, whose filters and drivers nothing here overrides; it is ignored.
case "${1-}" in
  diff|log|show) harden='--no-ext-diff --no-textconv --ignore-submodules=all' ;;
  status) harden='--ignore-submodules=all' ;;
  blame) harden='--no-textconv' ;;
  *) harden='' ;;
esac
if [ -n "$harden" ]; then
  sub=$1; shift
  # shellcheck disable=SC2086
  set -- "$sub" $harden "$@"
fi
# Filters named by the repository's own config (`clean`, `smudge`, `process`)
# run from `git diff` and `git status` through .gitattributes, and so do its
# diff drivers (`command`, `textconv`); the global and system config being
# ignored does nothing against them. Each one the config names is overridden
# with an empty value, which disables it (and a `required` filter then fails
# instead of running). A name git cannot take back through `-c` (one with
# `=`) is refused rather than left active.
set -f
keys=$(@REAL_GIT@ config --name-only --get-regexp '^(filter\..*\.(clean|smudge|process)|diff\..*\.(command|textconv))$' 2>/dev/null) || keys=
old_ifs=$IFS; IFS='
'
for k in $keys; do
  case "$k" in
    *=*) echo "delegate: la clave $k no se puede anular; git está denegado en este repo" >&2; exit 126 ;;
  esac
  set -- -c "$k=" "$@"
done
IFS=$old_ifs
set +f
# Signature verification runs gpg.program (or its ssh and x509 variants) from
# `git log` and `git show` on any signed commit, with log.showSignature in the
# repository's config or --show-signature on the command line. Verified with a
# crafted signed commit. All three point at /bin/false.
exec @REAL_GIT@ -c core.fsmonitor=false -c core.pager=cat -c core.hooksPath=/dev/null -c diff.external= \
  -c log.showSignature=false -c gpg.program=/bin/false -c gpg.ssh.program=/bin/false \
  -c gpg.x509.program=/bin/false --no-pager "$@"
WRAP
)"
    printf '%s\n' "${wrapper//@REAL_GIT@/\'${real_git//\'/\'\\\'\'}\'}" > "$stub_dir/git"
    chmod +x "$stub_dir/git"
  fi
  # The sandbox prefix, now that the stub directory exists. The seccomp
  # program lives in it (private, 700) and reaches bwrap as fd 9, which the
  # supervisor opens for the child alone; inside, the harness is started by
  # its resolved path, since the symlink that PATH found may live in the home
  # that the sandbox hides.
  _DG_X_SBX=()
  _DG_X_BPF=''
  if [[ "$sandbox" == 'bwrap' ]]; then
    local claude_real
    claude_real="$(readlink -f -- "$claude_bin")" || die "no puedo resolver $claude_bin"
    dg_seccomp_bpf "$HOSTTYPE" > "$stub_dir/.seccomp.bpf" || die "no pude escribir el filtro seccomp"
    _DG_X_BPF="$stub_dir/.seccomp.bpf"
    dg_sandbox_argv "$bwrap_bin" "$wroot" "$stub_dir" "$claude_real" 9 \
      ${sbx_ro_real[@]+"${sbx_ro_real[@]}"}
    claude_bin="$claude_real"
  fi
  export PATH="$stub_dir:$PATH"

  local claude_args=(
    -p
    --bare
    # --bare skips hooks and the like, but on its own it still resolves a
    # `/skill-name` in the prompt against the user's installed skills, and
    # --add-dir only ADDS access rather than confining anything. --restricted
    # ignores the user, project and local settings files and confines the file
    # tools to the working directories; --disable-slash-commands closes the
    # skill route. Bash survives both because --tools names it, which is why
    # the read-only floor below is the thing that has to hold.
    --restricted
    --disable-slash-commands
    --setting-sources "project,local"
    --strict-mcp-config
    --permission-mode "dontAsk"
    --output-format "$format"
  )
  if [[ "$mode" == 'agent' ]]; then
    claude_args+=(
      --add-dir "$workdir"
      --tools "$DG_TOOLS"
      --allowedTools "$DG_ALLOWED"
    )
  else
    claude_args+=(--tools '')
  fi
  # --strict-mcp-config is already above, so with no --mcp-config the child
  # reaches no server at all. This adds one only when a server was requested.
  [[ -n "$DG_MCP_JSON" ]] && claude_args+=(--mcp-config "$DG_MCP_JSON")

  # Defence in depth, not a boundary. An allow list matches a command name, so
  # `git diff --output=path` passes the read-only floor and writes a file — two
  # independent reviews found it. Denying the shapes that write raises the cost
  # without pretending to close it: a deny list is prefix matching too, and the
  # honest limit of the floor is written down in CLAUDE.md. It is unconditional
  # only on the floor: `--bash` is unrestricted shell by definition, and denying
  # a form there would be a narrower grant than the one that was asked for.
  if [[ "$mode" == 'agent' ]] && (( ! want_bash )); then
    claude_args+=(--disallowedTools
      'Bash(git diff --output*),Bash(git log --output*),Bash(git show --output*)')
  fi

  # LAST on purpose, and it must stay last. `--tools` and `--allowedTools` are
  # variadic (`<tools...>`): they keep eating arguments until the next option,
  # so a prompt sitting right after them was parsed as one more tool name and
  # the child died with "Input must be provided either through stdin or as a
  # prompt argument". Ending on an option that takes exactly one value is what
  # makes the positional prompt reach the child. Anything appended after this
  # has to take exactly one value too.
  #
  # And then `--`, so the task can never be read as an option. Without it,
  # `delegate deepseek -- --help` handed `--help` to the harness, which printed
  # its usage and exited 0: a run that reported success without doing the task.
  # Verified against the installed harness that `-- --help` is taken as the
  # prompt. The prompt itself is appended at exec time, right after this.
  claude_args+=(--append-system-prompt "$DG_RULES" --)

  # Names the entries asked to forward. Values are never in the config: the
  # child inherits whatever this shell has under that name, and a name that is
  # unset here is simply not forwarded — the server will say what it needs.
  local passthrough=() n fwd=()
  for n in ${DG_MCP_ENV[@]+"${DG_MCP_ENV[@]}"}; do
    if [[ -n "${!n+set}" ]]; then
      passthrough+=("$n=${!n}")
      fwd+=("$n")
    else
      warn "el servidor MCP pidió reenviar ${B}${n}${R}, que no está definida en este shell"
    fi
  done
  # Said out loud, every time. The tool used to warn about a name it could NOT
  # forward and stay silent about the ones it did, which is backwards: since the
  # child's environment is built from an allowlist, this list is the complete
  # set of things from this shell that cross into the delegated run. A token
  # leaving for the cheap provider's endpoint should not be the quiet case.
  # Names only — a value never appears in this output.
  if (( ${#fwd[@]} )); then
    warn "se reenvían al hijo, por pedido de un servidor MCP: ${B}$(printf '%s\n' "${fwd[@]}" | join_lines)${R}"
  fi

  cd "$workdir"
  # Harmless notice from Claude Code when it titles a session with a model it
  # does not know. It goes to stderr, but it dirties any `2>&1` over --json.
  #
  # Under `env -i`: this filter lives as long as the run and starts before the
  # environment wipe, so it used to hold the parent's whole environment —
  # GITHUB_TOKEN, AWS_* — readable in its /proc/<pid>/environ for the entire
  # run. Verified with a sentinel. grep needs nothing from the environment, and
  # `exec` leaves no forked copy of this shell behind it.
  exec 2> >(exec "$env_bin" -i "$grep_bin" --line-buffered -v '\[claude-code:unrecognized_model\]' >&2)

  # The environment is BUILT, not inherited. `env -u A -u B VAR=x cmd` keeps
  # everything else the parent had, so GITHUB_TOKEN, AWS_*, NODE_OPTIONS and
  # any exported function reached the delegated run even with no flags at all —
  # which is the opposite of what invariant 3 claims. `env -i` starts from
  # nothing and only what is named below gets through.
  #
  # Keep the values worth carrying over, then drop every exported name and put
  # only these back. These are what the harness needs to run at all, and none is
  # a credential: HOME (where node and claude keep state), PATH (already
  # rewritten above so the stubs come first), the identity and locale that
  # tooling reads, TMPDIR, and the CA overrides, which matter behind a corporate
  # proxy and carry a path, not a secret.
  #
  # Everything the exec needs is published in `_DG_X_*` globals and this
  # function RETURNS, so that the wipe below runs in a scope where none of these
  # names is local any more. That is not style: inside a function `unset -v key`
  # removes the LOCAL binding and leaves it in an "unset local" state that masks
  # the caller's variable instead of exposing it, so a parent that exported
  # `key`, `prompt`, `model` or `claude_bin` — every one of them a plain name
  # this function declares — survived the wipe and reached the child. Verified,
  # `export -n` behaves the same way. With cmd_run returned, its locals are gone
  # and the unset reaches the real thing.
  _DG_X_BIN="$claude_bin"
  _DG_X_PROMPT="$prompt"
  _DG_X_TIMEOUT="$timeout_s"
  _DG_X_TIMEOUT_BIN="$timeout_bin"
  _DG_X_ENV_BIN="$env_bin"
  _DG_X_ENDPOINT="${CFG[endpoint]}"
  _DG_X_MODEL="$model"
  _DG_X_SMALL="${CFG[small_model]}"
  _DG_X_AUTHENV="${CFG[auth_env]}"
  _DG_X_KEY="$key"
  _DG_X_ARGS=("${claude_args[@]}")

  # Resolved here, while the parent's values are still readable: the wipe is
  # about to remove them.
  _DG_X_KEEP=()
  local kn
  for kn in HOME PATH USER LOGNAME SHELL TERM LANG LC_ALL TZ TMPDIR \
            SSL_CERT_FILE SSL_CERT_DIR NODE_EXTRA_CA_CERTS; do
    [[ -n "${!kn+set}" ]] && _DG_X_KEEP+=("$kn=${!kn}")
  done
  _DG_X_PASS=(${passthrough[@]+"${passthrough[@]}"})
  return 0
}

# ─── el exec del hijo ────────────────────────────────────────────────────────
#
# Se llama desde el despacho, DESPUÉS de que cmd_run retornó. Todos sus locals
# llevan el prefijo `_dg_` y el wipe lo excluye, así que ningún nombre que el
# padre pueda exportar queda tapado por un local de aquí.
dg_exec_child() {
  local _dg_n _dg_pair

  # The wipe. `env -u A -u B VAR=x cmd` keeps everything else the parent had, so
  # GITHUB_TOKEN, AWS_*, NODE_OPTIONS and any exported function reached the
  # delegated run even with no flags at all — the opposite of what invariant 3
  # claims. Clearing the export list here, rather than passing `env -i` a list
  # of assignments, is what keeps the key out of an argv (see below).
  for _dg_n in $(compgen -e); do
    [[ $_dg_n == _dg_* || $_dg_n == _DG_* || $_dg_n == CFG ]] && continue
    unset -v "$_dg_n" 2>/dev/null || true
  done

  # Exported functions were already dropped at the top of the script, before
  # anything ran a single external command; see the note there.
  #
  # The wipe above clears what bash can NAME. It cannot clear an environ entry
  # whose name is not a valid identifier — `SECRET-TOKEN=...`, `A.B=...`, or a
  # `BASH_FUNC_x%%` that bash declined to import — because bash never made a
  # variable out of it, and it hands every such entry to each child untouched.
  # Verified: `SECRET-TOKEN` crossed the wipe and reached the delegated run.
  # So the child is started under `env -i`, and only what is named here exists
  # on the other side.
  #
  # The values do NOT travel in env's argv. `env -i ANTHROPIC_API_KEY=<key> ...`
  # puts the key in /proc/<pid>/cmdline, world-readable on Linux, for as long
  # as env runs; the same goes for a forwarded token. They travel NUL-separated
  # through fd 3, a pipe from a builtin `printf`, into a trampoline: a
  # `/bin/bash -p` that started from an empty environment, exports each pair,
  # closes the pipe and execs timeout. Its argv holds the trampoline text, the
  # harness arguments and the prompt, which were already arguments before.
  local -a _dg_pairs=(
    ${_DG_X_KEEP[@]+"${_DG_X_KEEP[@]}"}
    ${_DG_X_PASS[@]+"${_DG_X_PASS[@]}"}
    "ANTHROPIC_BASE_URL=$_DG_X_ENDPOINT"
    "ANTHROPIC_MODEL=$_DG_X_MODEL"
    "ANTHROPIC_DEFAULT_OPUS_MODEL=$_DG_X_MODEL"
    "ANTHROPIC_DEFAULT_SONNET_MODEL=$_DG_X_MODEL"
    "ANTHROPIC_DEFAULT_HAIKU_MODEL=$_DG_X_SMALL"
    "CLAUDE_CODE_SUBAGENT_MODEL=$_DG_X_SMALL"
    # Last, so nothing above can shadow it.
    "${_DG_X_AUTHENV}=$_DG_X_KEY"
  )
  # The supervisor, a single-quoted constant: nothing in it is expanded here.
  #
  # This shell does NOT stay alive to wait for the child. Unsetting variables
  # never touches /proc/<pid>/environ, which keeps the environment a process
  # was STARTED with, so a CLI waiting for the child held the parent's
  # credentials there — readable by any same-user process, and by an allowed
  # `grep` on the read-only floor — for the whole run. Verified with a
  # sentinel. It execs instead into `env -i /bin/bash -p`, which starts from an
  # empty environment: same pid, nothing in its environ. That bash exports the
  # pairs for its child only, launches the child in the background, waits for
  # it, removes the stub directory and exits with the child's code.
  #
  # Each signal is forwarded as itself: INT and HUP used to arrive as TERM, so a
  # harness with its own handling for an interrupt or a hangup never saw one.
  #
  # The cleanup cannot change that code: this bash runs without errexit, and
  # the status is kept in `r` and passed to `exit` explicitly. Under the CLI's
  # `set -e`, a failing `rm` in the old EXIT trap turned a child's 7 into 1.
  local _dg_super='
    while IFS= read -r -d "" kv <&3; do export "$kv" || exit 125; done
    exec 3<&-
    # Every descriptor but 0, 1 and 2 closed before the child is launched: the
    # process substitutions (the pairs on fd 3 and the stderr filter) left the
    # shell holding its own copies, and the harness inherited them as fd 3 and 63.
    for f in /proc/$BASHPID/fd/*; do
      n=${f##*/}
      if (( n > 2 )); then { exec {n}<&-; } 2>/dev/null; fi
    done
    s=$1 rm=$2 bpf=$3; shift 3
    cleanup() { if [[ -n $s && -d $s ]]; then "$rm" -rf -- "$s" 2>/dev/null; fi; return 0; }
    trap cleanup EXIT
    # The traps go in BEFORE the launch. Installed after it, a signal arriving
    # in between killed this shell untrapped: the EXIT trap removed the stubs
    # and the child ran on without them. One that lands before `c` is known is
    # kept in `p` and delivered right after the launch.
    c= p=
    for g in TERM INT HUP; do
      trap "if [ -n \"\$c\" ]; then kill -s $g \$c 2>/dev/null; else p=$g; fi" "$g"
    done
    # With the sandbox, its seccomp program goes to bwrap as fd 9, opened here
    # for the child alone, after every inherited descriptor was closed.
    if [[ -n $bpf ]]; then "$@" 9<"$bpf" & else "$@" & fi
    c=$!
    if [ -n "$p" ]; then kill -s "$p" "$c" 2>/dev/null; fi
    while :; do
      r=0; wait "$c" || r=$?
      kill -0 "$c" 2>/dev/null || break
    done
    cleanup
    trap - EXIT
    exit "$r"
  '

  # The stub directory now belongs to the supervisor: the EXIT trap of this
  # shell goes away with the exec.
  trap - EXIT
  exec "$_DG_X_ENV_BIN" -i /bin/bash -p -c "$_dg_super" delegate-run \
    "$_DG_X_STUBS" "$_DG_X_RM" "$_DG_X_BPF" \
    "$_DG_X_TIMEOUT_BIN" "$_DG_X_TIMEOUT" \
    ${_DG_X_SBX[@]+"${_DG_X_SBX[@]}"} \
    "$_DG_X_BIN" "${_DG_X_ARGS[@]}" "$_DG_X_PROMPT" \
    3< <(printf '%s\0' "${_dg_pairs[@]}") \
    < /dev/null  # sin terminal, `claude -p` espera 3 s por stdin antes de arrancar
}

# Removes the run's private stub directory. Only ever a directory this run
# created with mktemp, whose path is in _DG_X_STUBS.
dg_cleanup_stubs() {
  if [[ -n "${_DG_X_STUBS:-}" && -d "$_DG_X_STUBS" ]]; then
    "${_DG_X_RM:-rm}" -rf -- "$_DG_X_STUBS"
  fi
  return 0
}

# ─── despacho ────────────────────────────────────────────────────────────────

case "${1:-help}" in
  help|--help|-h) usage ;;
  providers)      cmd_providers ;;
  mcp)            shift; cmd_mcp "$@" ;;
  account)        shift; cmd_account "$@" ;;
  -*)             die "las opciones van después del proveedor: delegate <proveedor> $1 ..." ;;
  *)
    PROVIDER="$1"; shift
    load_provider "$PROVIDER"
    # Dos pasos a propósito: cmd_run publica en `_DG_X_*` y retorna, para que el
    # wipe del environment corra sin sus locals vivos. Ver la nota en cmd_run.
    cmd_run "$@"
    dg_exec_child
    ;;
esac
